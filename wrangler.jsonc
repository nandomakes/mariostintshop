{
  // Sitio estático + /api/apply (antes Vercel Function en api/apply.js).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mariostintshop",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Vercel sin trailingSlash sirve /careers y /careers/ con 200; esto redirige a la forma con barra.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // El Worker corre primero para poder 301 el apex (mariostintshop.com) a www
    // antes de que el asset server responda. En cualquier otro host no redirige
    // y delega en assets (_redirects, html_handling, _headers). /api/apply no cambia.
    "run_worker_first": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": { "enabled": true },
  // Límite por IP (3 envíos/min) y tope global (20/min). El binding de Cloudflare es aproximado
  // (contadores por ubicación, consistencia eventual): sirve contra abuso pero no es un contador exacto.
  // El periodo solo admite 10 o 60 s, así que no hay tope diario con este binding.
  "ratelimits": [
    { "name": "APPLY_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "APPLY_GLOBAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ]
  // Secretos del Worker (no van aquí ni en el build):
  //   npx wrangler secret put RESEND_API_KEY
  //   npx wrangler secret put CAREERS_NOTIFY_EMAIL
  //   npx wrangler secret put CAREERS_FROM_EMAIL
  // INSTAGRAM_TOKEN sigue siendo de build (CI / la máquina que construye), no del Worker.
}
