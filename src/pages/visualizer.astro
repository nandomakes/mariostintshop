---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import QuoteCTA from '../components/QuoteCTA.astro';
import Footer from '../components/Footer.astro';
import CallFab from '../components/CallFab.astro';
import { SITE, IMAGES } from '../consts';
import { PHOTO_VEHICLES } from '../lib/vehicles-photo';

// Still frames of the same two camera angles the 3D viewer used (drag was
// already disabled). Masks for each glass zone and PPF package are layered
// on top. Regenerate with scripts/render-visualizer-frames.mjs.
const VEHICLE_IDS = ['sedan', 'suv', 'sport', 'truck'];
const VEHICLES = PHOTO_VEHICLES.filter((v) => VEHICLE_IDS.includes(v.id));

const title = `Window Tint & PPF Visualizer | ${SITE.brand}`;
// ≤155 chars so Google shows it whole — the previous copy ran to ~218 and was
// truncated mid-sentence in the SERP.
const description =
  'Preview 3M window tint shades and PPF coverage on a car, then send your build to Mario’s Tint Shop in Murfreesboro, TN for a free quote.';

// Mirrors the visual breadcrumb below.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Tint & PPF visualizer',
        item: `${SITE.url}/visualizer/`,
      },
    ],
  },
];

// ── Control data ─────────────────────────────────────────────────────
const TINT_ZONES = [
  { id: 'front-side', label: 'Front side windows' },
  { id: 'rear-side', label: 'Rear side windows' },
  { id: 'visor', label: 'Front window' },
  { id: 'rear', label: 'Rear window' },
];

// Coverage tiles: a dedicated sedan icon per zone with that zone's glass
// highlighted in accent blue (public/images/vehicles/<file>.png).
const ZONE_ICON_FILE: Record<string, string> = {
  'front-side': 'front-side-windows',
  'rear-side': 'rear-side-windows',
  visor: 'visor-strip',
  rear: 'rear-window',
};
const zoneTiles = TINT_ZONES.map((z) => ({ ...z, iconFile: ZONE_ICON_FILE[z.id] }));
const SHADES = [
  { id: 'dark', label: 'Dark', vlt: 'VLT 5–35', op: 0.85 },
  { id: 'medium', label: 'Medium', vlt: 'VLT 35–65', op: 0.58 },
  { id: 'light', label: 'Light', vlt: 'VLT 65–95', op: 0.32 },
  { id: 'clear', label: 'Clear', vlt: 'VLT 95–100', op: 0.14 },
];
const PRIORITIES = [
  { id: 'price', label: 'Price' },
  { id: 'heat', label: 'Heat rejection' },
  { id: 'signal', label: 'Signal clarity' },
  { id: 'appearance', label: 'Appearance' },
];

// Paint protection film packages, mirroring the industry-standard coverage
// tiers. `zones` are the ppf_* materials split out in build-models.mjs.
const PPF_PACKAGES = [
  {
    id: 'none',
    label: 'No protection',
    blurb: 'Bare paint — nothing applied.',
    panels: 'No film applied.',
    zones: [] as string[],
  },
  {
    id: 'partial-front',
    label: 'Partial front',
    blurb: 'The high-impact leading edges.',
    panels: 'Front bumper · leading edge of the hood & fenders · mirrors',
    zones: ['ppf_bumper_f', 'ppf_hood_f', 'ppf_mirror'],
  },
  {
    id: 'full-front',
    label: 'Full front',
    tag: 'Very popular',
    blurb: 'No cut line across the hood.',
    panels: 'Front bumper · full hood · full fenders · mirrors',
    zones: ['ppf_bumper_f', 'ppf_hood_f', 'ppf_hood_r', 'ppf_mirror'],
  },
  {
    id: 'track-pack',
    label: 'Track pack',
    blurb: 'Full front plus the panels that catch road debris.',
    panels: 'Full front · full rocker sill & lower doors · rear wheel arches · door cups and edges',
    zones: ['ppf_bumper_f', 'ppf_hood_f', 'ppf_hood_r', 'ppf_mirror', 'ppf_rocker'],
  },
  {
    id: 'full-wrap',
    label: 'Full wrap',
    blurb: 'Every painted panel on the vehicle.',
    panels: 'Every painted surface, front to back',
    zones: [
      'ppf_bumper_f', 'ppf_hood_f', 'ppf_hood_r', 'ppf_mirror',
      'ppf_rocker', 'ppf_roof', 'ppf_side', 'ppf_rear',
    ],
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="content">
    <!-- Hero image band -->
    <section class="relative overflow-hidden border-b border-line bg-ink">
      <div class="absolute inset-0" aria-hidden="true">
        <!-- This band is the mobile LCP (measured). It has to be eager and
             high priority; loading=lazy was holding the paint back. -->
        <Picture
          src={IMAGES.heroBg.src}
          alt=""
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          widths={[640, 1024, 1536]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="h-full w-full object-cover object-[center_62%] opacity-60"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/40 to-ink/70"></div>
      </div>
      <div class="relative mx-auto max-w-6xl px-5 pb-14 pt-24 md:pb-20 md:pt-32">
        <nav class="reveal text-[11px] font-bold uppercase tracking-[0.16em] text-smoke" aria-label="Breadcrumb">
          <a href="/" class="transition-colors hover:text-paper">Home</a>
          <span class="mx-2 text-line">/</span>
          <span class="text-accent">Tint &amp; PPF visualizer</span>
        </nav>
      </div>
    </section>

    <!-- Title + intro -->
    <section class="border-b border-sand bg-paper">
      <div class="mx-auto max-w-4xl px-5 py-12 text-center md:py-14">
        <h1 class="reveal headline text-[clamp(1.4rem,2.8vw,2.1rem)] text-ink">
          Window tint &amp; paint protection film visualizer
        </h1>
        <p class="reveal mx-auto mt-5 max-w-[64ch] text-[15px] leading-relaxed text-char">
          Preview 3M window tint or paint protection film (PPF) on your car — switch between
          the two modes below. Select a car category, determine the coverage area, pick a
          tint shade or PPF package, and switch between front and rear view to preview the look before you buy.
        </p>
      </div>
    </section>

    <!-- Vehicle type strip -->
    <section class="border-b border-sand bg-paper">
      <div class="mx-auto max-w-4xl px-5 py-6">
        <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" role="radiogroup" aria-label="Vehicle type">
          {
            VEHICLES.map((v, i) => (
              <button
                type="button"
                role="radio"
                aria-checked={i === 0 ? 'true' : 'false'}
                data-vehicle={v.id}
                data-vehicle-label={v.label}
                class:list={[
                  'veh-chip pressable group flex flex-col items-center gap-1.5 border px-2 pb-2.5 pt-3 transition-colors duration-200',
                  i === 0 ? 'border-accent bg-mint' : 'border-sand hover:border-ash/60',
                ]}
              >
                <span class="veh-thumb-frame flex h-9 w-full items-center justify-center overflow-hidden" data-veh={v.id}>
                  <img
                    src={v.photo}
                    alt=""
                    width="120"
                    height="47"
                    loading="lazy"
                    class="veh-thumb h-full w-full object-contain transition-[filter,opacity] duration-200"
                  />
                </span>
                <span class="text-[10px] font-bold uppercase tracking-[0.14em] text-ink transition-colors group-aria-checked:text-accentDk">
                  {v.label}
                </span>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Visualizer: controls left · 3D preview right -->
    <section id="visualizer" class="bg-paper">
      <div class="mx-auto grid max-w-6xl gap-8 px-5 py-10 md:py-14 lg:grid-cols-[5fr_7fr] lg:items-start">
        <!-- Controls column -->
        <div class="min-w-0 border border-sand bg-whisper lg:order-1">
          <!-- Mode switcher + reset. Two equal cards rather than text tabs so
               both modes read as choices — users kept missing that PPF was
               here at all. -->
          <div class="border-b border-sand px-3 pb-3 pt-2.5">
            <div class="mb-2 flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-[0.16em] text-ash">Choose what to preview</span>
              <button
                type="button" id="reset-btn"
                class="pressable flex items-center gap-1.5 px-1 py-1 text-[10px] font-bold uppercase tracking-[0.12em] text-ash transition-colors hover:text-accentDk"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
                Start over
              </button>
            </div>
            <div class="grid grid-cols-2 gap-2" role="tablist" aria-label="Simulator mode">
              <button
                type="button" role="tab" data-mode="tint" aria-selected="true"
                id="mode-tab-tint" aria-controls="mode-panel-tint"
                class="mode-tab pressable group relative flex flex-col items-center gap-2 border border-sand bg-paper px-3 py-3 text-center transition-colors duration-200 hover:border-ash/60 aria-selected:border-accent aria-selected:bg-accent sm:flex-row sm:gap-3 sm:text-left"
              >
                <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-mint text-accentDk transition-colors duration-200 group-aria-selected:bg-ink group-aria-selected:text-accent" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2.2-5.5A2 2 0 0 1 7 6h10a2 2 0 0 1 1.8 1.5L21 13"/><path d="M3 13h18v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M8 10l2-3M13 10l2-3"/></svg>
                </span>
                <span class="min-w-0">
                  <span class="block whitespace-nowrap text-[10px] font-bold uppercase tracking-[0.04em] text-ink sm:text-[11px] sm:tracking-[0.1em]">Window Tint</span>
                  <span class="block text-[10px] leading-tight text-ash group-aria-selected:text-ink/70">Glass shades</span>
                </span>
              </button>
              <button
                type="button" role="tab" data-mode="ppf" aria-selected="false"
                id="mode-tab-ppf" aria-controls="mode-panel-ppf"
                class="mode-tab pressable group relative flex flex-col items-center gap-2 border border-sand bg-paper px-3 py-3 text-center transition-colors duration-200 hover:border-ash/60 aria-selected:border-accent aria-selected:bg-accent sm:flex-row sm:gap-3 sm:text-left"
              >
                <span class="flex h-9 w-9 shrink-0 items-center justify-center bg-mint text-accentDk transition-colors duration-200 group-aria-selected:bg-ink group-aria-selected:text-accent" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6z"/><path d="M9.2 12l2 2 3.6-3.7"/></svg>
                </span>
                <span class="min-w-0">
                  <span class="block whitespace-nowrap text-[10px] font-bold uppercase tracking-[0.04em] text-ink sm:text-[11px] sm:tracking-[0.1em]">Paint Protection</span>
                  <span class="block text-[10px] leading-tight text-ash group-aria-selected:text-ink/70">Body panels (PPF)</span>
                </span>
                <!-- Attention marker: pulses until PPF is opened once. -->
                <span class="mode-dot absolute right-2 top-2 flex h-2.5 w-2.5" aria-hidden="true">
                  <span class="mode-dot-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                  <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-accent"></span>
                </span>
              </button>
            </div>
          </div>

          <!-- ══ Window-tint panel ══ -->
          <div data-panel="tint" id="mode-panel-tint" role="tabpanel" aria-labelledby="mode-tab-tint" tabindex="0">
          <!-- Accordion: coverage -->
          <div class="acc border-b border-sand px-6" data-open="true">
            <button type="button" class="acc-toggle flex w-full items-center justify-between py-4 text-left" aria-expanded="true">
              <span>
                <h2 class="block text-[11px] font-bold uppercase tracking-[0.16em] text-ink">Select the tint coverage</h2>
                <span class="mt-0.5 block text-xs text-ash">Select a coverage zone to get started.</span>
              </span>
              <svg class="acc-icon shrink-0 text-accentDk transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14" /><path class="acc-vert" d="M12 5v14" />
              </svg>
            </button>
            <div class="acc-body grid grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]">
              <div class="min-h-0 overflow-hidden">
                <div class="grid grid-cols-2 gap-2 pb-5 sm:grid-cols-4">
                  {
                    zoneTiles.map((z) => (
                      <button
                        type="button"
                        data-tint-zone={z.id}
                        aria-pressed="false"
                        class="zone-tile pressable group flex flex-col items-center gap-1 border border-sand bg-paper px-1.5 pb-2 pt-2.5 transition-colors duration-200 hover:border-ash/60 aria-pressed:border-accent aria-pressed:bg-mint"
                      >
                        <img
                          src={`/images/vehicles/${z.iconFile}.png`}
                          alt=""
                          width="528"
                          height="191"
                          loading="lazy"
                          class="h-10 w-full object-contain"
                        />
                        <span class="text-center text-[10px] font-bold leading-tight text-ink group-aria-pressed:text-accentDk">{z.label}</span>
                      </button>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Accordion: tint shade -->
          <div class="acc border-b border-sand px-6" data-open="true">
            <button type="button" class="acc-toggle flex w-full items-center justify-between py-4 text-left" aria-expanded="true">
              <span>
                <h2 class="block text-[11px] font-bold uppercase tracking-[0.16em] text-ink">Select the tint</h2>
                <span class="mt-0.5 block text-xs text-ash">The shade applies to the glass in the preview.</span>
              </span>
              <svg class="acc-icon shrink-0 text-accentDk transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14" /><path class="acc-vert" d="M12 5v14" />
              </svg>
            </button>
            <div class="acc-body grid grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]">
              <div class="min-h-0 overflow-hidden">
                <div class="grid grid-cols-2 gap-2 sm:grid-cols-4" role="radiogroup" aria-label="Tint shade">
                  {
                    SHADES.map((s) => (
                      <button
                        type="button" role="radio"
                        aria-checked={s.id === 'clear' ? 'true' : 'false'}
                        data-shade={s.id} data-shade-label={s.label} data-op={s.op}
                        class="shade-chip pressable border border-sand bg-paper p-2 text-center transition-colors duration-200 hover:border-ash/60 aria-checked:border-accent"
                      >
                        <span
                          class="block h-8 w-full border border-sand"
                          style={`background: linear-gradient(rgba(11,21,36,${s.op}), rgba(11,21,36,${s.op})), linear-gradient(135deg, #E8F1F8 0%, #BFD3E2 60%, #DCE9F4 100%)`}
                          aria-hidden="true"
                        />
                        <span class="mt-1.5 block text-xs font-bold text-ink">{s.label}</span>
                        <span class="block text-[10px] text-ash">{s.vlt}</span>
                      </button>
                    ))
                  }
                </div>
                <p class="pb-5 pt-2 text-[11px] leading-relaxed text-ash">
                  Tennessee requires 35%+ VLT on front side windows.
                </p>
              </div>
            </div>
          </div>

          <!-- Accordion: priorities -->
          <div class="acc px-6" data-open="true">
            <button type="button" class="acc-toggle flex w-full items-center justify-between py-4 text-left" aria-expanded="true">
              <span>
                <h2 class="block text-[11px] font-bold uppercase tracking-[0.16em] text-ink">What matters most?</h2>
                <span class="mt-0.5 block text-xs text-ash">Prioritize these benefits to help us find the right tint for you.</span>
              </span>
              <svg class="acc-icon shrink-0 text-accentDk transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                <path d="M5 12h14" /><path class="acc-vert" d="M12 5v14" />
              </svg>
            </button>
            <div class="acc-body grid grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]">
              <div class="min-h-0 overflow-hidden">
                <div class="flex flex-wrap gap-2 pb-5">
                  {
                    PRIORITIES.map((p) => (
                      <button
                        type="button"
                        data-priority={p.id}
                        aria-pressed="false"
                        class="prio-chip pressable border border-sand bg-paper px-3.5 py-2 text-xs font-bold text-ink transition-colors duration-200 hover:border-ash/60 aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-ink"
                      >
                        {p.label}
                      </button>
                    ))
                  }
                </div>
              </div>
            </div>
          </div>

          <!-- Cross-sell into the other mode: the shop does both in one visit. -->
          <div class="flex flex-wrap items-center gap-4 border-t border-sand bg-paper px-6 py-5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-mint text-accentDk" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6z"/><path d="M9.2 12l2 2 3.6-3.7"/></svg>
            </span>
            <div class="min-w-0 flex-1 basis-40">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-ink">Protecting the paint too?</p>
              <p class="mt-0.5 text-xs leading-snug text-ash">Same preview — see which panels each PPF package covers.</p>
            </div>
            <button
              type="button" data-switch-mode="ppf"
              class="pressable w-full shrink-0 border border-accent px-3 py-2.5 text-center text-[10px] font-bold uppercase tracking-[0.12em] text-accentDk transition-colors duration-200 hover:bg-accent hover:text-ink sm:w-auto"
            >
              Preview PPF <span class="font-black" aria-hidden="true">&gt;</span>
            </button>
          </div>
          </div>

          <!-- ══ Paint-protection panel ══ -->
          <div data-panel="ppf" id="mode-panel-ppf" role="tabpanel" aria-labelledby="mode-tab-ppf" tabindex="0" hidden>
            <div class="acc border-b border-sand px-6" data-open="true">
              <button type="button" class="acc-toggle flex w-full items-center justify-between py-4 text-left" aria-expanded="true">
                <span>
                  {/* Distinct from the tint panel's "Select the coverage" —
                      two identical H2s muddied the document outline. */}
                  <h2 class="block text-[11px] font-bold uppercase tracking-[0.16em] text-ink">Select the PPF coverage</h2>
                  <span class="mt-0.5 block text-xs text-ash">Protected panels are highlighted in green on the preview.</span>
                </span>
                <svg class="acc-icon shrink-0 text-accentDk transition-transform duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                  <path d="M5 12h14" /><path class="acc-vert" d="M12 5v14" />
                </svg>
              </button>
              <div class="acc-body grid grid-rows-[1fr] transition-[grid-template-rows] duration-300 ease-[cubic-bezier(0.23,1,0.32,1)]">
                <div class="min-h-0 overflow-hidden">
                  <div class="flex flex-col gap-2 pb-5" role="radiogroup" aria-label="PPF coverage">
                    {
                      PPF_PACKAGES.map((p) => (
                        <button
                          type="button" role="radio"
                          aria-checked={p.id === 'none' ? 'true' : 'false'}
                          data-ppf={p.id}
                          data-ppf-label={p.label}
                          data-ppf-panels={p.panels}
                          data-ppf-zones={p.zones.join(',')}
                          class="ppf-tile pressable border border-sand bg-paper p-3 text-left transition-colors duration-200 hover:border-ash/60 aria-checked:border-accent aria-checked:bg-mint"
                        >
                          <span class="flex items-center gap-2">
                            <span class="text-xs font-bold text-ink">{p.label}</span>
                            {p.tag && (
                              <span class="bg-accent px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-[0.1em] text-ink">
                                {p.tag}
                              </span>
                            )}
                          </span>
                          <span class="mt-0.5 block text-[11px] leading-snug text-ash">{p.blurb}</span>
                        </button>
                      ))
                    }
                  </div>
                  <p class="pb-5 text-[11px] leading-relaxed text-ash">
                    Self-healing 3M film. If it's painted, it can be protected — ask us about
                    headlights, door sills, trunk wear strips, and interior screens.
                  </p>
                </div>
              </div>
            </div>

            <div class="flex flex-wrap items-center gap-4 border-t border-sand bg-paper px-6 py-5">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center bg-mint text-accentDk" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13l2.2-5.5A2 2 0 0 1 7 6h10a2 2 0 0 1 1.8 1.5L21 13"/><path d="M3 13h18v4a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M8 10l2-3M13 10l2-3"/></svg>
              </span>
              <div class="min-w-0 flex-1 basis-40">
                <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-ink">Want the glass done too?</p>
                <p class="mt-0.5 text-xs leading-snug text-ash">Tint and PPF happen in the same appointment.</p>
              </div>
              <button
                type="button" data-switch-mode="tint"
                class="pressable w-full shrink-0 border border-accent px-3 py-2.5 text-center text-[10px] font-bold uppercase tracking-[0.12em] text-accentDk transition-colors duration-200 hover:bg-accent hover:text-ink sm:w-auto"
              >
                Preview Tint <span class="font-black" aria-hidden="true">&gt;</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Preview column: still frames on a white stage -->
        <div class="min-w-0 lg:order-2">
          <div class="border border-sand bg-whisper p-4 sm:p-6">
            <!-- Toolbar: angle toggle left · PDF download top-right -->
            <div class="mb-3 flex items-center justify-between gap-2">
              <!-- Toggle buttons, not tabs: they carry aria-pressed and control
                   no tabpanels, so role="tablist" would be an invalid contract. -->
              <div class="flex items-center gap-1" role="group" aria-label="Vehicle angle">
                <button
                  type="button" data-angle="front" aria-pressed="true"
                  class="angle-btn pressable border border-sand bg-paper px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-ink transition-colors duration-200 aria-pressed:border-accent aria-pressed:bg-accent"
                >
                  Front view
                </button>
                <button
                  type="button" data-angle="rear" aria-pressed="false"
                  class="angle-btn pressable border border-sand bg-paper px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-ink transition-colors duration-200 aria-pressed:border-accent aria-pressed:bg-accent"
                >
                  Rear view
                </button>
              </div>
              <button
                type="button"
                id="pdf-btn"
                class="pressable flex items-center gap-1.5 border border-sand bg-paper px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-ink transition-colors duration-200 hover:border-accent hover:text-accentDk"
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="M7 10l5 5 5-5"/><path d="M12 15V3"/></svg>
                <span class="hidden sm:inline">Download PDF</span>
                <span class="sm:hidden">PDF</span>
              </button>
            </div>

            <div id="stage" class="relative aspect-[4/3] w-full overflow-hidden border border-sand bg-white sm:aspect-[860/520]">
              <picture class="absolute inset-0 block h-full w-full">
                <source
                  id="stage-avif"
                  type="image/avif"
                  srcset="/images/visualizer/sedan-front-640.avif 640w, /images/visualizer/sedan-front.avif 1290w"
                  sizes="(min-width: 1024px) 640px, 100vw"
                />
                <img
                  id="stage-base"
                  src="/images/visualizer/sedan-front-640.webp"
                  srcset="/images/visualizer/sedan-front-640.webp 640w, /images/visualizer/sedan-front.webp 1290w"
                  sizes="(min-width: 1024px) 640px, 100vw"
                  width="1290"
                  height="780"
                  alt="Sedan, front view, no tint selected"
                  decoding="async"
                  fetchpriority="low"
                  class="h-full w-full object-contain"
                />
              </picture>
              <div id="stage-layers" class="pointer-events-none absolute inset-0" aria-hidden="true"></div>
            </div>
            <p id="preview-hint" class="mt-2 text-[10px] leading-relaxed text-ash">
              Switch between front and rear view · pick a tint shade to see it on the glass
            </p>

            <!-- Live summary -->
            <div class="mt-3 flex flex-wrap items-center justify-between gap-3 border-t border-sand pt-4">
              <p id="build-summary" class="min-w-0 flex-1 text-xs font-semibold uppercase tracking-[0.08em] text-char" aria-live="polite"></p>
              <span id="legal-badge" class="shrink-0 bg-accent/15 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-accentDk"></span>
            </div>
          </div>

          <!-- CTAs under the preview -->
          <a
            id="visualizer-cta"
            href="#contact"
            class="pressable sticker mx-auto mt-6 block max-w-md bg-accent px-8 py-4 text-center text-xs font-bold uppercase tracking-[0.12em] text-ink transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-accentDk"
          >
            Get Free Quote <span class="ml-0.5 font-black" aria-hidden="true">&gt;</span>
          </a>
          <p class="mt-2.5 text-center text-[11px] text-ash">
            Jumps to our quote form below — we reply with a free quote.
          </p>

          <p class="mx-auto mt-6 max-w-xl text-center text-[11px] leading-relaxed text-ash">
            Visual representations are shown for illustrative purposes only; vehicles are
            generic vehicle previews and actual appearances treated with window film may vary.
          </p>
        </div>
      </div>
    </section>

    <QuoteCTA />
  </main>
  <Footer />
  <CallFab />

  <style>
    /* Photo thumbnails in the vehicle picker: dim until selected. */
    .veh-chip .veh-thumb {
      filter: grayscale(0.5) brightness(0.97);
      opacity: 0.62;
    }
    .veh-chip[aria-checked='true'] .veh-thumb {
      filter: none;
      opacity: 1;
    }

    /* Vehicle-type icons: source PNGs have different framing/aspect ratios
       (sedan 2.76:1, sport 3.02:1, suv 2.32:1, truck 2.35:1). A fixed-height
       flex frame + object-fit: contain scales every icon to the same
       rendered height (no cropping), so the four line up at matching
       visual weight regardless of source canvas size. */
    .veh-thumb-frame[data-veh='sport'] .veh-thumb {
      transform: scale(0.94);
    }

    /* PPF attention marker: pings until the mode is opened once. */
    .mode-dot-ping {
      animation: mode-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
    @keyframes mode-ping {
      75%, 100% {
        transform: scale(2.4);
        opacity: 0;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .mode-dot-ping {
        animation: none;
      }
    }

    /* Accordions: +/− icon morph and body collapse. */
    .acc[data-open='false'] .acc-body {
      grid-template-rows: 0fr;
    }
    .acc .acc-icon .acc-vert {
      transition: transform 300ms var(--ease-out), opacity 300ms var(--ease-out);
      transform-origin: center;
    }
    .acc[data-open='true'] .acc-icon .acc-vert {
      transform: scaleY(0);
      opacity: 0;
    }

    @media (prefers-reduced-motion: reduce) {
      .acc-body {
        transition: none !important;
      }
    }

  </style>

  <script>
    // Logo for the PDF export. Imported (not hardcoded) so it resolves to the
    // hashed /_astro/ URL — a literal path would 404 after any asset change.
    import logoUrl from '../assets/images/logo-mario.webp';

    const $$ = <T extends HTMLElement = HTMLElement>(sel: string) =>
      Array.from(document.querySelectorAll<T>(sel));

    // ══ Visualizer state ═════════════════════════════════════════════
    const state = {
      vehicle: 'sedan',
      vehicleLabel: 'Sedan',
      mode: 'tint' as 'tint' | 'ppf',
      tintZones: new Set<string>(),
      shade: 'clear',
      shadeLabel: 'Clear',
      shadeOp: 0.14,
      priorities: new Set<string>(),
      ppf: 'none',
      ppfLabel: 'No protection',
      ppfPanels: 'No film applied.',
      ppfZones: [] as string[],
    };

    const ZONE_LABELS: Record<string, string> = {
      'rear-side': 'Rear side windows',
      'front-side': 'Front side windows',
      rear: 'Rear window',
      visor: 'Front window',
      price: 'Price',
      heat: 'Heat rejection',
      signal: 'Signal clarity',
      appearance: 'Appearance',
    };
    const SHADE_META: Record<string, { vlt: string; frontLegal: boolean }> = {
      dark: { vlt: 'VLT 5–35', frontLegal: false },
      medium: { vlt: 'VLT 35–65', frontLegal: true },
      light: { vlt: 'VLT 65–95', frontLegal: true },
      clear: { vlt: 'VLT 95–100', frontLegal: true },
    };

    const summary = document.getElementById('build-summary')!;
    const badge = document.getElementById('legal-badge')!;
    const stageBase = document.getElementById('stage-base') as HTMLImageElement;
    const stageAvif = document.getElementById('stage-avif') as HTMLSourceElement;
    const stageLayers = document.getElementById('stage-layers')!;

    // How strongly the black glass mask darkens the still. Clear stays a
    // hint of film; dark reads as a tinted window on the photograph.
    const TINT_OP: Record<string, number> = {
      clear: 0.1,
      light: 0.32,
      medium: 0.55,
      dark: 0.82,
    };

    let angle: 'front' | 'rear' = 'front';
    let frameToken = 0;
    let shownFrame = 'sedan-front';

    function frameFile(vehicle: string, view: 'front' | 'rear', ext: 'avif' | 'webp', small = false) {
      return `/images/visualizer/${vehicle}-${view}${small ? '-640' : ''}.${ext}`;
    }

    function stageAlt() {
      const view = angle === 'front' ? 'front view' : 'rear view';
      const bits = [`${state.vehicleLabel}, ${view}`];
      if (state.tintZones.size) {
        const zones = [...state.tintZones].map((z) => ZONE_LABELS[z]).join(', ');
        bits.push(`${state.shadeLabel} tint on ${zones}`);
      } else {
        bits.push('no tint selected');
      }
      if (state.ppf !== 'none') bits.push(`paint protection: ${state.ppfLabel}`);
      return bits.join(', ');
    }

    // Masks are fetched only for the zones the visitor actually picks.
    function syncLayers() {
      const prefix = `/images/visualizer/${state.vehicle}-${angle}`;
      const specs: { key: string; src: string; op: number }[] = [];
      if (state.ppf !== 'none') {
        specs.push({
          key: `ppf-${state.vehicle}-${angle}-${state.ppf}`,
          src: `${prefix}-ppf-${state.ppf}.webp`,
          op: 1,
        });
      }
      const op = TINT_OP[state.shade] ?? 0.55;
      for (const zone of state.tintZones) {
        specs.push({ key: `tint-${state.vehicle}-${angle}-${zone}`, src: `${prefix}-${zone}.webp`, op });
      }
      const keep = new Set(specs.map((s) => s.key));
      for (const img of [...stageLayers.querySelectorAll('img')]) {
        if (!keep.has(img.dataset.key || '')) img.remove();
      }
      for (const spec of specs) {
        let img = stageLayers.querySelector<HTMLImageElement>(`img[data-key="${spec.key}"]`);
        if (!img) {
          img = document.createElement('img');
          img.dataset.key = spec.key;
          img.alt = '';
          img.decoding = 'async';
          img.className = 'absolute inset-0 h-full w-full object-contain';
          img.src = spec.src;
          stageLayers.appendChild(img);
        }
        img.dataset.op = String(spec.op);
        img.style.opacity = String(spec.op);
        stageLayers.appendChild(img);
      }
      stageBase.alt = stageAlt();
    }

    const preloaded = new Set<string>();
    function preloadView(vehicle: string, view: 'front' | 'rear') {
      const href = frameFile(vehicle, view, 'avif', true);
      if (preloaded.has(href)) return;
      preloaded.add(href);
      const link = document.createElement('link');
      link.rel = 'preload';
      link.as = 'image';
      link.type = 'image/avif';
      link.href = href;
      link.dataset.preload = href;
      document.head.appendChild(link);
    }

    // Swap the still only after the next frame has decoded, so the box
    // never collapses and the previous car stays put until the new one is ready.
    async function showFrame() {
      const vehicle = state.vehicle;
      const view = angle;
      const key = `${vehicle}-${view}`;
      if (shownFrame === key) {
        syncLayers();
        return;
      }
      const token = ++frameToken;
      const small = new Image();
      small.src = frameFile(vehicle, view, 'webp', true);
      try {
        await small.decode();
      } catch {
        /* a failed decode still falls through to the src swap */
      }
      if (token !== frameToken) return;
      stageAvif.srcset = `${frameFile(vehicle, view, 'avif', true)} 640w, ${frameFile(vehicle, view, 'avif')} 1290w`;
      stageBase.srcset = `${frameFile(vehicle, view, 'webp', true)} 640w, ${frameFile(vehicle, view, 'webp')} 1290w`;
      stageBase.src = frameFile(vehicle, view, 'webp', true);
      shownFrame = key;
      syncLayers();
      const other: 'front' | 'rear' = view === 'front' ? 'rear' : 'front';
      preloadView(vehicle, other);
    }

    const angleGroup = document.querySelector<HTMLElement>('[aria-label="Vehicle angle"]')!;
    const angleButtons = () => $$<HTMLButtonElement>('.angle-btn');
    angleButtons().forEach((b, i) => {
      b.tabIndex = i === 0 ? 0 : -1;
    });
    function pressAngle(btn: HTMLButtonElement) {
      angle = btn.dataset.angle as 'front' | 'rear';
      angleButtons().forEach((c) => {
        const on = c === btn;
        c.setAttribute('aria-pressed', String(on));
        c.tabIndex = on ? 0 : -1;
      });
      showFrame();
    }
    angleButtons().forEach((b) => b.addEventListener('click', () => pressAngle(b)));
    angleGroup.addEventListener('keydown', (e) => {
      const key = (e as KeyboardEvent).key;
      const dir = key === 'ArrowRight' || key === 'ArrowDown' ? 1 : key === 'ArrowLeft' || key === 'ArrowUp' ? -1 : 0;
      if (!dir) return;
      const buttons = angleButtons();
      const current = buttons.indexOf(document.activeElement as HTMLButtonElement);
      if (current === -1) return;
      e.preventDefault();
      const next = buttons[(current + dir + buttons.length) % buttons.length];
      next.focus();
      pressAngle(next);
    });

    // ══ Render cycle ═══════════════════════════════════════════════════
    const okBadge =
      'shrink-0 bg-accent/15 px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-accentDk';
    const warnBadge =
      'shrink-0 bg-[#FFF1CC] px-3 py-1.5 text-[10px] font-bold uppercase tracking-[0.12em] text-[#8A5B00]';

    function render() {
      // While a new still is decoding, keep the previous masks. showFrame
      // paints the new ones in the same turn it swaps the photograph.
      if (shownFrame === `${state.vehicle}-${angle}`) syncLayers();

      // The summary describes the whole build, not just the open tab, since
      // both halves are applied to the preview at once.
      const parts = [state.vehicleLabel];
      if (state.tintZones.size) {
        const zones = [...state.tintZones].map((z) => ZONE_LABELS[z]).join(', ');
        parts.push(`${state.shadeLabel} tint (${SHADE_META[state.shade].vlt}) · ${zones}`);
      }
      if (state.ppf !== 'none') parts.push(`PPF: ${state.ppfLabel}`);
      if (parts.length === 1) {
        parts.push(state.mode === 'ppf' ? 'no film selected yet' : 'no tint zones yet');
      }
      summary.textContent = parts.join(' · ');

      // A front-side tint that breaks the TN limit outranks anything else.
      const frontTinted = state.tintZones.has('front-side');
      const illegal = frontTinted && !SHADE_META[state.shade].frontLegal;
      if (illegal) {
        badge.textContent = 'TN: 35%+ required on front sides';
        badge.className = warnBadge;
        return;
      }
      badge.className = okBadge;
      if (state.ppf !== 'none') badge.textContent = 'Self-healing 3M film';
      else if (state.tintZones.size) badge.textContent = 'TN legal · selected zones';
      else badge.textContent = state.mode === 'ppf' ? 'Pick a coverage' : 'Pick a coverage zone';
    }

    // ══ Mode tabs: window tint ⇄ paint protection ═════════════════════
    const previewHint = document.getElementById('preview-hint')!;
    function setMode(mode: 'tint' | 'ppf') {
      state.mode = mode;
      $$('.mode-tab').forEach((t) => {
        t.setAttribute('aria-selected', String(t.dataset.mode === mode));
      });
      // The marker has done its job once PPF has been seen.
      if (mode === 'ppf') document.querySelector('.mode-dot')?.remove();
      $$('[data-panel]').forEach((p) => {
        (p as HTMLElement).hidden = p.dataset.panel !== mode;
      });
      previewHint.textContent =
        mode === 'ppf'
          ? "Switch between front and rear view · green shows where the film is applied"
          : 'Switch between front and rear view · pick a tint shade to see it on the glass';
      render();
    }
    $$('.mode-tab').forEach((tab) =>
      tab.addEventListener('click', () => setMode(tab.dataset.mode as 'tint' | 'ppf'))
    );
    // Cross-mode nudges at the bottom of each panel. On phones the switcher
    // is a full panel above, so bring it back into view and hand it focus.
    $$('[data-switch-mode]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const mode = btn.dataset.switchMode as 'tint' | 'ppf';
        setMode(mode);
        const tab = document.getElementById(`mode-tab-${mode}`);
        tab?.scrollIntoView({ block: 'center', behavior: 'smooth' });
        tab?.focus({ preventScroll: true });
      })
    );

    $$('.ppf-tile').forEach((tile) =>
      tile.addEventListener('click', () => {
        state.ppf = tile.dataset.ppf!;
        state.ppfLabel = tile.dataset.ppfLabel!;
        state.ppfPanels = tile.dataset.ppfPanels!;
        state.ppfZones = (tile.dataset.ppfZones || '').split(',').filter(Boolean);
        $$('.ppf-tile').forEach((t) => t.setAttribute('aria-checked', String(t === tile)));
        render();
      })
    );

    // ══ Controls ═══════════════════════════════════════════════════════
    $$('.veh-chip').forEach((chip) =>
      chip.addEventListener('click', () => {
        const id = chip.dataset.vehicle!;
        if (state.vehicle === id) return;
        state.vehicle = id;
        state.vehicleLabel = chip.dataset.vehicleLabel!;
        $$('.veh-chip').forEach((c) => {
          const on = c === chip;
          c.setAttribute('aria-checked', String(on));
          c.classList.toggle('border-accent', on);
          c.classList.toggle('bg-mint', on);
          c.classList.toggle('border-sand', !on);
        });
        showFrame();
        render();
        preloadView(id, 'front');
      })
    );

    $$('.zone-tile[data-tint-zone]').forEach((tile) =>
      tile.addEventListener('click', () => {
        const z = tile.dataset.tintZone!;
        if (state.tintZones.has(z)) state.tintZones.delete(z);
        else state.tintZones.add(z);
        tile.setAttribute('aria-pressed', String(state.tintZones.has(z)));
        render();
      })
    );

    $$('.shade-chip').forEach((chip) =>
      chip.addEventListener('click', () => {
        state.shade = chip.dataset.shade!;
        state.shadeLabel = chip.dataset.shadeLabel!;
        state.shadeOp = Number(chip.dataset.op);
        $$('.shade-chip').forEach((c) => c.setAttribute('aria-checked', String(c === chip)));
        render();
      })
    );

    $$('.prio-chip').forEach((chip) =>
      chip.addEventListener('click', () => {
        const p = chip.dataset.priority!;
        if (state.priorities.has(p)) state.priorities.delete(p);
        else state.priorities.add(p);
        chip.setAttribute('aria-pressed', String(state.priorities.has(p)));
        render();
      })
    );

    // Accordions. aria-controls is wired here rather than in the markup so the
    // id and the reference can never drift apart.
    $$('.acc-toggle').forEach((btn, i) => {
      const acc = btn.closest('.acc') as HTMLElement;
      const body = acc.querySelector<HTMLElement>('.acc-body');
      if (body) {
        body.id = body.id || `acc-panel-${i}`;
        btn.setAttribute('aria-controls', body.id);
      }
      btn.addEventListener('click', () => {
        const open = acc.dataset.open === 'true';
        acc.dataset.open = String(!open);
        btn.setAttribute('aria-expanded', String(!open));
      });
    });

    // role="radiogroup" carries a keyboard contract: arrow keys move between
    // options and only the checked one is a tab stop (roving tabindex). The
    // markup declared the roles without it, so screen-reader and keyboard
    // users got an interaction that did not behave like the radios it claimed
    // to be. One handler covers all three groups (vehicle, shade, PPF).
    $$('[role="radiogroup"]').forEach((group) => {
      const radios = Array.from(group.querySelectorAll<HTMLElement>('[role="radio"]'));
      if (!radios.length) return;

      const syncTabStops = () => {
        const checked = radios.find((r) => r.getAttribute('aria-checked') === 'true');
        radios.forEach((r) => {
          r.tabIndex = r === (checked ?? radios[0]) ? 0 : -1;
        });
      };
      syncTabStops();
      // Selection is driven by the existing click handlers, so re-derive the
      // roving tab stop whenever aria-checked changes anywhere in the group.
      new MutationObserver(syncTabStops).observe(group, {
        subtree: true,
        attributes: true,
        attributeFilter: ['aria-checked'],
      });

      group.addEventListener('keydown', (e) => {
        const key = (e as KeyboardEvent).key;
        const dir =
          key === 'ArrowRight' || key === 'ArrowDown'
            ? 1
            : key === 'ArrowLeft' || key === 'ArrowUp'
              ? -1
              : 0;
        if (!dir) return;
        const current = radios.indexOf(document.activeElement as HTMLElement);
        if (current === -1) return;
        e.preventDefault();
        const nextEl = radios[(current + dir + radios.length) % radios.length];
        nextEl.focus();
        nextEl.click(); // radios select on arrow, per the APG pattern
      });
    });

    // Start over
    document.getElementById('reset-btn')!.addEventListener('click', () => {
      state.tintZones = new Set();
      state.shade = 'clear';
      state.shadeLabel = 'Clear';
      state.shadeOp = 0.14;
      state.priorities = new Set();
      state.ppf = 'none';
      state.ppfLabel = 'No protection';
      state.ppfPanels = 'No film applied.';
      state.ppfZones = [];
      $$('.zone-tile[data-tint-zone]').forEach((t) =>
        t.setAttribute('aria-pressed', String(state.tintZones.has(t.dataset.tintZone!)))
      );
      $$('.shade-chip').forEach((c) => c.setAttribute('aria-checked', String(c.dataset.shade === 'clear')));
      $$('.prio-chip').forEach((c) => c.setAttribute('aria-pressed', 'false'));
      $$('.ppf-tile').forEach((c) => c.setAttribute('aria-checked', String(c.dataset.ppf === 'none')));
      angle = 'front';
      $$('.angle-btn').forEach((c) => {
        const on = c.dataset.angle === 'front';
        c.setAttribute('aria-pressed', String(on));
        c.tabIndex = on ? 0 : -1;
      });
      showFrame();
      render();
    });

    // ══ Boot ═══════════════════════════════════════════════════════════
    // The first still is in the HTML. Warm the other angle after idle so
    // the toggle does not wait on a cold request, without competing with LCP.
    setMode('tint');
    if ('requestIdleCallback' in window) {
      requestIdleCallback(() => preloadView('sedan', 'rear'));
    } else {
      setTimeout(() => preloadView('sedan', 'rear'), 600);
    }
    $$('.veh-chip').forEach((chip) => {
      const id = chip.dataset.vehicle!;
      const warm = () => preloadView(id, 'front');
      chip.addEventListener('pointerenter', warm);
      chip.addEventListener('focus', warm);
    });

    // ══ PDF configuration download (SunTek-style summary sheet) ═════════
    document.getElementById('pdf-btn')!.addEventListener('click', async () => {
      const btn = document.getElementById('pdf-btn') as HTMLButtonElement;
      btn.disabled = true;
      btn.style.opacity = '0.5';
      try {
        const { jsPDF } = await import('jspdf');
        const doc = new jsPDF({ unit: 'mm', format: 'a4' });
        const W = 210;
        const zones = [...state.tintZones].map((z) => ZONE_LABELS[z]).join(', ') || 'To be decided';
        const prio = [...state.priorities].map((p) => ZONE_LABELS[p] ?? p).join(', ') || '—';
        const frontTinted = state.tintZones.has('front-side');
        const legal = !frontTinted || SHADE_META[state.shade].frontLegal;

        // Brand palette (matches Tailwind theme: ink/paper/accent/char/sand).
        const INK: [number, number, number] = [17, 17, 17];
        const PAPER: [number, number, number] = [255, 255, 255];
        const ACCENT: [number, number, number] = [0, 168, 255];
        const CHAR: [number, number, number] = [51, 51, 51];
        const SAND: [number, number, number] = [238, 238, 238];
        const SMOKE: [number, number, number] = [163, 163, 163];

        // The site's display/body fonts (Special Gothic Expanded One, Inter)
        // ship only as woff/woff2 (self-hosted via @fontsource), which
        // jsPDF's TTF-only font embedding can't parse — embedding would
        // either silently fail or throw mid-render. Helvetica bold/normal,
        // set uppercase to echo the display font's blocky industrial look,
        // is the robust choice here: it always renders correctly.
        const displayFont = 'helvetica';
        const displayStyle: 'bold' | 'normal' = 'bold';
        const bodyFont = 'helvetica';

        // Logo: rasterize the site SVG onto a canvas (jsPDF needs a raster).
        let logoData: string | null = null;
        let logoRatio = 1;
        try {
          const img = new Image();
          img.crossOrigin = 'anonymous';
          await new Promise<void>((resolve, reject) => {
            img.onload = () => resolve();
            img.onerror = () => reject(new Error('logo load failed'));
            img.src = logoUrl.src;
          });
          const canvas = document.createElement('canvas');
          const size = 256;
          canvas.width = size;
          canvas.height = size;
          const ctx = canvas.getContext('2d')!;
          ctx.drawImage(img, 0, 0, size, size);
          logoData = canvas.toDataURL('image/png');
          logoRatio = img.naturalWidth && img.naturalHeight ? img.naturalWidth / img.naturalHeight : 1;
        } catch {
          /* logo unavailable — header still carries the brand text */
        }

        // Header band
        doc.setFillColor(...INK);
        doc.rect(0, 0, W, 30, 'F');
        let headerTextX = 14;
        if (logoData) {
          const logoH = 16;
          const logoW = logoH * logoRatio;
          doc.addImage(logoData, 'PNG', 14, 7, logoW, logoH, undefined, 'FAST');
          headerTextX = 14 + logoW + 5;
        }
        doc.setTextColor(...PAPER);
        doc.setFont(displayFont, displayStyle);
        doc.setFontSize(16);
        doc.text("MARIO'S TINT SHOP", headerTextX, 13);
        doc.setFontSize(9);
        doc.setFont(bodyFont, 'normal');
        doc.setTextColor(...ACCENT);
        doc.text(
          `${
            state.tintZones.size && state.ppf !== 'none'
              ? 'Window Tint & Paint Protection'
              : state.ppf !== 'none'
                ? 'Paint Protection'
                : 'Window Tint'
          } Configuration · Murfreesboro, TN`,
          headerTextX,
          20
        );
        doc.setFontSize(8);
        doc.setTextColor(...PAPER);
        doc.text(new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }), W - 14, 13, { align: 'right' });

        // Vehicle snapshot from the still, with the tint and PPF layers
        // flattened on top. Fit inside the box without stretching.
        try {
          const shotW = stageBase.naturalWidth || 1290;
          const shotH = stageBase.naturalHeight || 780;
          const flat = document.createElement('canvas');
          flat.width = shotW;
          flat.height = shotH;
          const ctx = flat.getContext('2d')!;
          ctx.fillStyle = '#ffffff';
          ctx.fillRect(0, 0, shotW, shotH);
          ctx.drawImage(stageBase, 0, 0, shotW, shotH);
          for (const layer of stageLayers.querySelectorAll('img')) {
            if (!layer.complete || !layer.naturalWidth) {
              try { await layer.decode(); } catch { continue; }
            }
            ctx.save();
            ctx.globalAlpha = Number(layer.dataset.op || '1');
            ctx.drawImage(layer, 0, 0, shotW, shotH);
            ctx.restore();
          }
          const shot = flat.toDataURL('image/png');
          const boxX = 14, boxY = 38, boxW = W - 28, boxH = 92;
          doc.setFillColor(...PAPER);
          doc.setDrawColor(...SAND);
          doc.rect(boxX, boxY, boxW, boxH, 'FD');
          const shotRatio = shotW / shotH;
          const padding = 4;
          const availW = boxW - padding * 2;
          const availH = boxH - padding * 2;
          let drawW = availW;
          let drawH = drawW / shotRatio;
          if (drawH > availH) {
            drawH = availH;
            drawW = drawH * shotRatio;
          }
          const drawX = boxX + (boxW - drawW) / 2;
          const drawY = boxY + (boxH - drawH) / 2;
          doc.addImage(shot, 'PNG', drawX, drawY, drawW, drawH, undefined, 'FAST');
        } catch {
          /* snapshot unavailable — PDF still carries the config table */
        }

        // Configuration table
        let y = 142;
        doc.setTextColor(...INK);
        doc.setFont(displayFont, displayStyle);
        doc.setFontSize(12);
        doc.text('Your build', 14, y);
        y += 8;
        const row = (label: string, value: string) => {
          doc.setFont(bodyFont, 'bold');
          doc.setFontSize(9);
          doc.setTextColor(...ACCENT);
          doc.text(label.toUpperCase(), 14, y);
          doc.setFont(bodyFont, 'normal');
          doc.setFontSize(10);
          doc.setTextColor(...CHAR);
          const lines = doc.splitTextToSize(value, W - 78);
          doc.text(lines, 64, y);
          y += 7 * lines.length;
          doc.setDrawColor(...SAND);
          doc.line(14, y - 4.5, W - 14, y - 4.5);
        };
        row('Vehicle type', state.vehicleLabel);
        // Both halves of the build go on the sheet when both are configured.
        if (state.tintZones.size) {
          row('Window tint', '3M window film');
          row('Coverage zones', zones);
          row('Tint shade', `${state.shadeLabel} (${SHADE_META[state.shade].vlt})`);
          row('TN legality', legal ? 'Legal for the selected zones' : 'Tennessee requires 35%+ VLT on front side windows');
        }
        if (state.ppf !== 'none') {
          row('Paint protection', '3M paint protection film');
          row('Coverage', state.ppfLabel);
          row('Panels covered', state.ppfPanels);
        }
        if (!state.tintZones.size && state.ppf === 'none') {
          row('Build', 'No coverage selected yet');
        }
        row('Priorities', prio);

        // Footer
        y = 272;
        doc.setFillColor(...INK);
        doc.rect(0, y - 8, W, 40, 'F');
        doc.setFont(displayFont, displayStyle);
        doc.setFontSize(10);
        doc.setTextColor(...PAPER);
        doc.text('Ready for a free quote?', 14, y);
        doc.setFont(bodyFont, 'normal');
        doc.setFontSize(9);
        doc.setTextColor(...ACCENT);
        doc.text('Send this configuration via WhatsApp or bring it to the shop — we reply fast.', 14, y + 6);
        doc.setTextColor(...PAPER);
        doc.text("Mario's Tint Shop · Murfreesboro, Tennessee", 14, y + 14);
        doc.setFontSize(7.5);
        doc.setTextColor(...SMOKE);
        doc.text('Visual representations are illustrative only; vehicles are generic previews and actual film appearance may vary.', 14, y + 21);

        doc.save('marios-tint-shop-configuration.pdf');
      } finally {
        btn.disabled = false;
        btn.style.opacity = '';
      }
    });
  </script>
</Layout>
