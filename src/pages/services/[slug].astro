---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import HeroService from '../../components/HeroService.astro';
import FeatureSplit from '../../components/FeatureSplit.astro';
import Faq from '../../components/Faq.astro';
import WarrantyBand from '../../components/WarrantyBand.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import QuoteCTA from '../../components/QuoteCTA.astro';
import Footer from '../../components/Footer.astro';
import CallFab from '../../components/CallFab.astro';
import { SERVICES, SITE, IMAGES, CONTENT_UPDATED, faqPageSchema } from '../../consts';

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props;
const img = IMAGES[service.pageImage ?? service.image];
// Second photo for the "Why …" split. Falls back to the hero image, but every
// service sets splitImage so the same picture no longer appears twice within
// one screen of scrolling.
const splitImg = IMAGES[service.splitImage ?? service.pageImage ?? service.image];
const title = service.metaTitle ?? `${service.name} in Murfreesboro, TN | ${SITE.brand}`;
// heroSubcopy doubles as page copy, so a service can override just the meta
// when its hero paragraph runs past what Google will display.
const description = service.metaDescription ?? service.heroSubcopy;

// Mirrors the visual breadcrumb rendered by HeroService, and turns the FAQ
// accordion into eligible rich results.
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: 'Services', item: `${SITE.url}/#services` },
      {
        '@type': 'ListItem',
        position: 3,
        name: service.name,
        item: `${SITE.url}/services/${service.slug}/`,
      },
    ],
  },
  faqPageSchema(service.faqs),
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${SITE.url}/services/${service.slug}/#service`,
    name: service.pageTitle ? `${service.pageTitle}, TN` : `${service.name} in Murfreesboro, TN`,
    description: service.metaDescription ?? service.heroSubcopy,
    dateModified: CONTENT_UPDATED,
    // Absolute URL to the hashed, optimized asset Astro emits for this page.
    image: new URL(img.src.src, SITE.url).href,
    serviceType: service.kicker,
    brand: { '@type': 'Brand', name: '3M' },
    provider: { '@id': `${SITE.url}/#business` },
    // The real service area, not just the home city — these are the towns the
    // page copy and FAQs already name. Rutherford County is a county, not a city.
    areaServed: [
      { name: 'Murfreesboro', type: 'City' },
      { name: 'Smyrna', type: 'City' },
      { name: 'La Vergne', type: 'City' },
      { name: 'Lebanon', type: 'City' },
      { name: 'Franklin', type: 'City' },
      { name: 'Brentwood', type: 'City' },
      { name: 'Nashville', type: 'City' },
      { name: 'Rutherford County', type: 'AdministrativeArea' },
    ].map(({ name, type }) => ({
      '@type': type,
      name,
      containedInPlace: { '@type': 'State', name: 'Tennessee' },
    })),
    url: `${SITE.url}/services/${service.slug}/`,
  },
];
---

<Layout title={title} description={description} schema={schema}>
  <Header />
  <main id="content">
    <HeroService
      kicker={service.kicker}
      title={service.pageTitle ?? service.name}
      subcopy={service.heroSubcopy}
      imageSrc={img.src}
    />

    <FeatureSplit
      kicker="About the service"
      title={`Why ${service.name}?`}
      paragraphs={[service.intro]}
      imageSrc={splitImg.src}
      imageAlt={splitImg.alt}
      word={service.splitWord}
      cta={{ href: '#contact', label: 'Get Free Quote' }}
    />

    <!-- Feature highlights. Headings come from the service so each page targets
         its own keywords instead of all five sharing "Built to protect". -->
    <section class="bg-ink">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
        <p class="kicker text-center text-accent">{service.featuresKicker ?? 'What you get'}</p>
        <h2 class="mt-3 mb-12 text-center headline text-[clamp(1.8rem,4vw,2.75rem)] text-paper">
          {service.featuresTitle ?? 'Built to protect'}
        </h2>
        <!-- 3-up so six features read as two balanced rows; still fine at four. -->
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {
            service.features.map((f) => (
              <div class="lift border border-line bg-coal p-5 sm:p-7">
                <h3 class="headline text-[13px] tracking-[0.03em] text-accent sm:text-base sm:tracking-[0.06em]">{f.title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-smoke">{f.body}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Process -->
    <section class="hex-bg bg-paper">
      <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
        <p class="kicker text-center text-accentDk">{service.processKicker ?? 'Our process'}</p>
        <h2 class="mt-3 mb-12 text-center headline text-[clamp(1.8rem,4vw,2.75rem)] text-ink">
          {service.processTitle ?? 'How it works'}
        </h2>
        <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            service.process.map((step, i) => (
              <li class="lift border border-sand bg-paper p-6 shadow-[0_2px_10px_rgba(0,0,0,0.05)]">
                <span class="headline text-3xl text-accentDk">{String(i + 1).padStart(2, '0')}</span>
                <p class="mt-3 text-sm leading-relaxed text-char">{step}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <WarrantyBand
      turnaround={service.turnaround}
      headline={service.warrantyHeadline}
      body={service.warrantyBody}
    />

    {
      service.slug === 'window-tinting' && (
        <section class="border-t border-sand bg-whisper">
          <div class="mx-auto max-w-3xl px-5 py-14 md:py-16">
            <p class="kicker text-accentDk">3M films</p>
            <h2 class="headline mt-3 text-[clamp(1.5rem,3vw,2.2rem)] text-ink">
              3M Color Stable, Ceramic IR, and Crystalline
            </h2>
            <p class="mt-5 text-[15px] leading-relaxed text-char">
              Mario’s Tint Shop in Murfreesboro installs 3M window tint in three films: 3M Color Stable IR, 3M Ceramic IR, and 3M Crystalline.
            </p>
            <ul class="mt-4 space-y-2 text-[15px] leading-relaxed text-char">
              <li><span class="font-bold text-ink">3M Color Stable IR:</span> a charcoal look and everyday value.</li>
              <li><span class="font-bold text-ink">3M Ceramic IR:</span> stronger heat comfort, up to 95% infrared rejection within 3M’s specified measurement range, and up to 99.9% UV.</li>
              <li><span class="font-bold text-ink">3M Crystalline:</span> more than 200 layers, with strong heat rejection and lighter shades.</li>
            </ul>
          </div>
        </section>
      )
    }

    <Faq items={service.faqs} heading={`${service.kicker} questions`} />

    <RelatedServices currentId={service.id} />

    <QuoteCTA defaultService={service.name} />
  </main>
  <Footer />
  <CallFab />
</Layout>
