---
// All four families are self-hosted: no render-blocking request to
// fonts.googleapis.com, no third-party DNS/TLS handshake on first paint, and
// no visitor IPs sent to Google. Latin subsets only — the site is English.
import '@fontsource-variable/inter';
import '@fontsource/special-gothic-expanded-one/latin-400.css';
import '@fontsource/sedgwick-ave/latin-400.css';
import '@fontsource/gabarito/latin-400.css';
// Imported (not a literal path) so the preload URL below always matches the
// hashed file Vite actually emits.
import specialGothicWoff2 from '@fontsource/special-gothic-expanded-one/files/special-gothic-expanded-one-latin-400-normal.woff2?url';
import '../styles/global.css';
import { SITE, CONTACT, PHONE_TEL, SERVICES, SOCIALS, TESTIMONIALS, GA4_ID } from '../consts';

interface Props {
  title?: string;
  description?: string;
  /** Keep this page out of the index (used by 404). */
  noindex?: boolean;
  /** Extra JSON-LD nodes for this page (BreadcrumbList, FAQPage, …). */
  schema?: unknown[];
}

const {
  title = SITE.title,
  description = SITE.description,
  noindex = false,
  schema = [],
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site).href;
// A real 1200×630 raster. SVG og:images are not rendered by any social
// platform, and Google rejects them for rich results.
const ogImage = new URL('/og-image.png', site).href;

// JSON-LD: local automotive business for SEO in Murfreesboro, TN
const business = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${SITE.url}/#business`,
  name: SITE.brand,
  description: SITE.description,
  url: SITE.url,
  image: ogImage,
  logo: new URL('/favicon-512.png', site).href,
  telephone: PHONE_TEL,
  email: CONTACT.email,
  priceRange: '$$$',
  address: {
    '@type': 'PostalAddress',
    streetAddress: CONTACT.address,
    addressLocality: 'Murfreesboro',
    addressRegion: 'TN',
    postalCode: '37130',
    addressCountry: 'US',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: CONTACT.geo.lat,
    longitude: CONTACT.geo.lng,
  },
  openingHoursSpecification: CONTACT.hoursSpec.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
    ...(h.byAppointment ? { description: 'By appointment only' } : {}),
  })),
  areaServed:
    'Murfreesboro, Nashville, Smyrna, Lebanon, La Vergne, Franklin, Brentwood, Rutherford County, and Middle Tennessee',
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '5.0',
    reviewCount: '390',
  },
  // Real reviews backing the aggregateRating above — Google discounts (and can
  // flag) a self-serving rating with no reviews attached to it.
  review: TESTIMONIALS.slice(0, 6).map((t) => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: t.author },
    reviewRating: { '@type': 'Rating', ratingValue: '5', bestRating: '5' },
    reviewBody: t.quote,
  })),
  sameAs: SOCIALS.map((s) => s.href),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Services',
    itemListElement: SERVICES.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.name },
    })),
  },
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.brand,
  publisher: { '@id': `${SITE.url}/#business` },
  inLanguage: 'en-US',
};

const jsonLdNodes = [business, website, ...schema];

// GA4. The property ID lives in consts; PUBLIC_GA4_ID overrides it so a
// staging deploy can point elsewhere (or set it empty to disable the tag).
// The CSP in vercel.json already allows googletagmanager/google-analytics.
// This is the site's ONLY Google tag — don't add a second one anywhere.
const ga4Id = import.meta.env.PUBLIC_GA4_ID ?? GA4_ID;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Display face: used by the H1 and every .headline, so it is on the
         critical path and worth preloading ahead of CSS discovery. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={specialGothicWoff2}
      crossorigin="anonymous"
    />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/* A noindex page shouldn't declare itself the canonical of anything —
        404 used to emit rel=canonical to /404/. */}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.brand} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="geo.region" content="US-TN" />
    <meta name="geo.placename" content="Murfreesboro" />
    <meta name="geo.position" content={`${CONTACT.geo.lat};${CONTACT.geo.lng}`} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.brand} — ${SITE.role} in ${SITE.city}`} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${SITE.brand} — ${SITE.role} in ${SITE.city}`} />

    {
      jsonLdNodes.map((node) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
      ))
    }

    {
      ga4Id && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
          <script is:inline define:vars={{ ga4Id }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', ga4Id);

            // The quote form is a cross-domain Tintwiz iframe, so its submit is
            // invisible to us. These two are the conversions we CAN measure.
            document.addEventListener('click', (e) => {
              const a = e.target.closest('a');
              if (!a) return;
              if (a.href.startsWith('tel:')) {
                gtag('event', 'phone_call_click', { link_url: a.href });
              } else if (a.getAttribute('href')?.includes('#contact')) {
                gtag('event', 'quote_cta_click', { link_text: a.textContent.trim() });
              }
            });
          </script>
        </>
      )
    }

    <!-- Enable "reveal" mode only when JS is present; without JS everything is visible -->
    <script is:inline>
      document.documentElement.setAttribute('data-reveal', '');
    </script>
  </head>
  <body class="bg-paper font-body text-char antialiased">
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-accent focus:px-4 focus:py-2 focus:font-bold focus:text-ink"
    >
      Skip to content
    </a>
    <slot />

    <script>
      // Smooth reveal on scroll (the CSS respects reduced-motion).
      const reveals = document.querySelectorAll<HTMLElement>('.reveal');

      // Stagger: each element takes its index among its `.reveal` siblings,
      // so grids and rows cascade in.
      reveals.forEach((el) => {
        const siblings = el.parentElement
          ? Array.from(el.parentElement.children).filter((c) => c.classList.contains('reveal'))
          : [el];
        el.style.setProperty('--reveal-i', String(Math.min(siblings.indexOf(el), 6)));
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1, rootMargin: '0px 0px -8% 0px' }
      );
      reveals.forEach((el) => io.observe(el));

      // Header: intensify on scroll for a subtle depth cue.
      const header = document.querySelector('header');
      if (header) {
        const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 20);
        onScroll();
        window.addEventListener('scroll', onScroll, { passive: true });
      }

      // Count-up for stat numbers when they scroll into view.
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const countIO = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            const target = Number(el.dataset.count) || 0;
            countIO.unobserve(el);
            if (reduce) {
              el.textContent = String(target);
              return;
            }
            const dur = 1100;
            const start = performance.now();
            const tick = (now: number) => {
              const p = Math.min((now - start) / dur, 1);
              const eased = 1 - Math.pow(1 - p, 3);
              el.textContent = String(Math.round(eased * target));
              if (p < 1) requestAnimationFrame(tick);
            };
            requestAnimationFrame(tick);
          });
        },
        { threshold: 0.5 }
      );
      counters.forEach((c) => countIO.observe(c));
    </script>
  </body>
</html>
