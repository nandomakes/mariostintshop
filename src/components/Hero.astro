---
import { Picture } from 'astro:assets';
import { HERO, IMAGES, CAREERS } from '../consts';
import Ticker from './Ticker.astro';
---

<section
  id="home"
  class="relative flex min-h-[calc(100svh-72px)] flex-col overflow-hidden bg-ink md:min-h-[calc(100svh-116px)]"
>
  <!-- Full-bleed image with dark overlay for legibility -->
  <div class="absolute inset-0" aria-hidden="true">
    <!-- LCP element. Eager + high priority, and served as AVIF/WebP at the
         width the viewport actually needs — the 2752px original is only ever
         sent to displays that can use it. -->
    <Picture
      src={IMAGES.heroBg.src}
      alt=""
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      widths={[640, 1024, 1536, 2048, 2752]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      class="h-full w-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-ink/60 via-transparent to-ink"></div>
  </div>

  <div class="relative w-full flex-1 content-center px-4 py-10 text-left sm:px-5 sm:py-12 md:py-16">
    {/* max-w-4xl, not 2xl: the headline face is very wide, and at the 52px the
        clamp tops out at, each H1 line needs ~740px. The md:pl-16 eats 64px of
        whatever this cap is, so 2xl left only 608px of text width and both H1
        lines re-wrapped — a two-line headline rendered as five. 4xl leaves
        832px. The subcopy keeps its own max-w-[52ch], so the paragraph measure
        is unaffected by the wider cap. */}
    <div class="w-full max-w-4xl sm:pl-6 md:pl-16">
      {
        CAREERS.hiring && CAREERS.openings.length > 0 && (
          <a
            href="/careers/#openings"
            class="reveal pressable group mb-5 inline-flex items-center gap-2.5 whitespace-nowrap border border-accent/60 bg-ink/70 py-2 pl-3 pr-3.5 text-[10px] font-bold uppercase tracking-[0.14em] text-paper backdrop-blur-sm transition-colors duration-200 hover:border-accent hover:bg-ink md:mb-6 md:text-[11px]"
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="hero-hiring-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75" />
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent" />
            </span>
            <span class="text-accent">We're hiring</span>
            <span class="text-line" aria-hidden="true">|</span>
            {CAREERS.openings.length} open jobs
            <span class="font-black text-accent transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">&gt;</span>
          </a>
        )
      }
      <p class="reveal kicker text-[clamp(1rem,3vw,1.35rem)] text-accent">{HERO.kicker}</p>

      {/* 1.3rem floor keeps each line whole on a 375px phone; at 1.6rem the
          H1 broke into four lines with "TN" orphaned on the last. */}
      <h1 class="reveal headline mt-3 text-[clamp(1.3rem,4.5vw,3.25rem)] text-paper md:mt-4">
        {/* The space before <br> is deliberate: without it the extracted text
            of the H1 reads "…Protectionin Murfreesboro, TN". It renders
            invisibly, since trailing whitespace before a line break collapses. */}
        {HERO.line1} <br />{HERO.line2}
      </h1>

      <p class="reveal mt-5 max-w-[52ch] text-[clamp(0.9rem,2.5vw,1.125rem)] leading-relaxed text-smoke md:mt-6">
        {HERO.sub}
      </p>

      <div class="reveal mt-7 flex flex-col items-start gap-3 sm:flex-row md:mt-9">
        <a
          href="/#contact"
          class="pressable sticker bg-accent px-8 py-3.5 text-center text-xs font-bold uppercase tracking-[0.12em] text-ink transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-accentDk"
        >
          Get Free Quote <span class="ml-0.5 font-black" aria-hidden="true">&gt;</span>
        </a>
        <a
          href="/visualizer/"
          class="pressable border border-paper/40 bg-paper/5 px-8 py-3.5 text-center text-xs font-bold uppercase tracking-[0.12em] text-paper backdrop-blur-sm transition-colors duration-200 hover:border-accent hover:text-accent"
        >
          Try the Tint &amp; PPF Visualizer <span class="ml-0.5 font-black" aria-hidden="true">&gt;</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Single ticker strip for the whole site -->
  <Ticker />
</section>

<style>
  .hero-hiring-ping {
    animation: hero-hiring-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite;
  }
  @keyframes hero-hiring-ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-hiring-ping {
      animation: none;
    }
  }
</style>
