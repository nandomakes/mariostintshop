---
import { GOOGLE_RATING } from '../consts';

interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<a
  href={GOOGLE_RATING.url}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[
    'group inline-flex items-center gap-3 border border-sand bg-paper px-4 py-3 transition-colors duration-200 hover:border-accent sm:gap-4 sm:px-6 sm:py-4',
    className,
  ]}
  aria-label={`${GOOGLE_RATING.value.toFixed(1)} out of 5 on Google, based on ${GOOGLE_RATING.count}+ reviews — opens Google Business profile`}
>
  <!-- Google "G" mark -->
  <svg viewBox="0 0 48 48" aria-hidden="true" class="h-6 w-6 shrink-0 sm:h-[30px] sm:w-[30px]">
    <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-3.1-.4-4.6H24v9h11.8c-.5 2.8-2.1 5.1-4.4 6.7v5.5h7.1c4.2-3.9 6.6-9.6 6.6-16.6z"/>
    <path fill="#34A853" d="M24 46c6 0 11-2 14.6-5.3l-7.1-5.5c-2 1.3-4.5 2.1-7.5 2.1-5.8 0-10.6-3.9-12.4-9.1H4.3v5.7C7.9 41.1 15.4 46 24 46z"/>
    <path fill="#FBBC05" d="M11.6 28.2c-.5-1.3-.7-2.7-.7-4.2s.3-2.9.7-4.2v-5.7H4.3C2.8 17 2 20.4 2 24s.8 7 2.3 9.9l7.3-5.7z"/>
    <path fill="#EA4335" d="M24 10.7c3.3 0 6.2 1.1 8.5 3.3l6.3-6.3C34.9 4.1 29.9 2 24 2 15.4 2 7.9 6.9 4.3 14.1l7.3 5.7c1.8-5.2 6.6-9.1 12.4-9.1z"/>
  </svg>

  <div class="flex flex-col gap-1">
    <div class="flex items-center gap-2">
      <span class="headline text-base tracking-[0.04em] text-ink sm:text-lg">EXCELLENT</span>
      <div class="flex gap-0.5 text-accent" aria-hidden="true">
        {
          Array.from({ length: 5 }).map(() => (
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8L12 2z" />
            </svg>
          ))
        }
      </div>
    </div>
    <p class="text-xs font-semibold text-ash">
      Based on <span class="text-char underline decoration-accent/40 underline-offset-2">{GOOGLE_RATING.count}+ Google reviews</span>
    </p>
  </div>
</a>
