---
// Editorial text + photo split for the service pages.
//
// The photo is shown whole at its own aspect ratio — never cropped to fill a
// column — and is pulled up so it straddles the seam between the dark hero
// and this white section, the way a magazine opener hangs a print over the
// fold. Behind it, the service word set in the display face as outlined
// type (the same treatment as the ticker strips) anchors the composition.
import { Image } from 'astro:assets';

interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  paragraphs?: string[];
  // An imported asset from src/assets — <Image> reads its intrinsic size, so
  // callers no longer pass width/height.
  imageSrc: ImageMetadata;
  imageAlt: string;
  // Short display word set as outlined type behind the photo (e.g. "PPF").
  word?: string;
  reverse?: boolean; // image on the left instead of the right
  cta?: { href: string; label: string };
}

const {
  kicker,
  title,
  lead,
  paragraphs = [],
  imageSrc,
  imageAlt,
  word,
  reverse = false,
  cta,
} = Astro.props;

const textOrder = reverse ? 'lg:order-2' : 'lg:order-1';
const imgOrder = reverse ? 'lg:order-1' : 'lg:order-2';
const wordSide = reverse ? 'left-0 -translate-x-[4%]' : 'right-0 translate-x-[4%]';
---

<section class="hex-bg relative overflow-x-clip bg-paper">
  {
    word && (
      <span
        class:list={[
          'headline pointer-events-none absolute bottom-0 hidden select-none whitespace-nowrap text-[clamp(6rem,20vw,17rem)] leading-[0.8] text-transparent md:block',
          wordSide,
        ]}
        style="-webkit-text-stroke: 1.5px rgba(17,17,17,0.09);"
        aria-hidden="true"
      >
        {word}
      </span>
    )
  }

  <div class="relative mx-auto flex max-w-6xl flex-col px-5 pb-20 md:pb-28 lg:grid lg:grid-cols-12 lg:items-center lg:gap-12">
    <div class={`reveal order-2 pt-12 lg:col-span-5 lg:pt-24 ${textOrder}`}>
      {kicker && <span class="kicker mb-4 block text-accentDk">{kicker}</span>}
      <h2 class="headline text-[clamp(1.8rem,3.5vw,2.5rem)] text-ink" set:html={title} />
      {lead && <p class="mt-5 max-w-[56ch] text-lg font-semibold leading-snug text-ink">{lead}</p>}
      {paragraphs.map((p) => <p class="mt-4 max-w-[62ch] leading-relaxed text-char">{p}</p>)}
      {
        cta && (
          <a
            href={cta.href}
            class="pressable sticker mt-8 inline-block bg-accent px-8 py-3.5 text-xs font-bold uppercase tracking-[0.12em] text-ink transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-accentDk"
          >
            {cta.label}
          </a>
        )
      }
    </div>

    <!-- The print. Negative top margin hangs it over the hero above; the
         figure shrink-wraps the image so the caption rule matches its width. -->
    <figure class={`reveal order-1 -mt-14 flex flex-col items-center md:-mt-20 lg:col-span-7 ${imgOrder}`}>
      <Image
        src={imageSrc}
        alt={imageAlt}
        widths={[640, 1024, 1400]}
        sizes="(min-width: 1024px) 55vw, 100vw"
        loading="eager"
        class="h-auto max-h-[36rem] w-auto max-w-full shadow-[0_48px_80px_-32px_rgba(0,0,0,0.55)]"
      />
      <figcaption class="mt-5 flex items-center gap-3 self-start text-[11px] font-semibold uppercase tracking-[0.14em] text-ash">
        <span class="h-px w-8 bg-accent" aria-hidden="true"></span>
        {imageAlt}
      </figcaption>
    </figure>
  </div>
</section>
