---
import { INSTAGRAM } from '../consts';
import { getInstagramFeed } from '../lib/instagram';

// Pulls the shop's latest Instagram posts at build time (falls back to the
// curated images in consts.ts when no INSTAGRAM_TOKEN is configured).
const tiles = await getInstagramFeed(7);

// Bento layout: columns 1–3 each stack two photos (varying split per column),
// column 4 is one full-height photo — 7 tiles total.
// 20-row grid so column 3's split can land at a moderate 45/55 — columns 1–2
// keep their original ~30/70 ratio (just rescaled onto the finer 20 rows).
const layout = [
  { col: 1, row: '1 / 7' },   // 0: col 1, short (top)   — 30%
  { col: 1, row: '7 / 21' },  // 1: col 1, tall (bottom)  — 70%
  { col: 2, row: '1 / 15' },  // 2: col 2, tall (top)     — 70%
  { col: 2, row: '15 / 21' }, // 3: col 2, short (bottom) — 30%
  { col: 3, row: '1 / 10' },  // 4: col 3, short (top)    — 45%
  { col: 4, row: '1 / 21' },  // 5: col 4, full height
  { col: 3, row: '10 / 21' }, // 6: col 3, tall (bottom)  — 55%
];

// Phones get their own bento rather than a flattened version of the desktop
// one: two columns whose tall tile sits on opposite rows so the seam between
// them zig-zags instead of running straight across, then the odd seventh
// photo as a full-width closing banner. 15 row tracks; both columns fill
// exactly 11 of them before the banner takes the last 4.
const layoutMobile = [
  { col: 1, row: '1 / 6' },   // 0: col 1, tall
  { col: 2, row: '1 / 4' },   // 1: col 2, short
  { col: 2, row: '4 / 9' },   // 2: col 2, tall
  { col: 1, row: '6 / 9' },   // 3: col 1, short
  { col: 1, row: '9 / 12' },  // 4: col 1, short
  { col: 2, row: '9 / 12' },  // 5: col 2, short
  { col: '1 / -1', row: '12 / 16' }, // 6: full-width banner
];
---

<section id="gallery" class="bg-ink">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="text-center">
      <p class="reveal kicker text-accent">Our latest work</p>
      <h2 class="reveal headline mx-auto mt-3 max-w-3xl text-[clamp(1.4rem,2.8vw,2.2rem)] text-paper">
        Where craftsmanship meets flawless finish
      </h2>
    </div>

    <div
      class="reveal showcase-grid mt-12 grid grid-cols-2 gap-3 sm:aspect-auto sm:h-[420px] sm:grid-cols-4 sm:gap-4 sm:[grid-template-rows:repeat(20,1fr)] md:h-[560px]"
    >
      {
        tiles.map((img, i) => {
          const spot = layout[i];
          const m = layoutMobile[i];
          return (
            <div
              class="group relative overflow-hidden"
              style={`--col:${spot.col}; --row:${spot.row}; --mcol:${m.col}; --mrow:${m.row};`}
            >
              <img
                src={img.src}
                alt={img.alt}
                width="600"
                height="600"
                loading="lazy"
                decoding="async"
                draggable="false"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.05]"
              />
            </div>
          );
        })
      }
    </div>

    <p class="reveal mt-8 text-center text-sm text-smoke">
      See our latest tint, PPF, and ceramic work —
      <a
        href={INSTAGRAM.url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-accent underline underline-offset-4 transition-colors hover:text-accentDk"
      >
        {INSTAGRAM.handle}
      </a>
    </p>
  </div>
</section>

<style>
  /* Desktop bento: each photo's column/row span comes from its --col/--row
     custom properties (set inline per-item above). */
  @media (min-width: 640px) {
    .showcase-grid > div {
      grid-column: var(--col);
      grid-row: var(--row);
    }
  }
  /* Phones run their own two-column bento off --mcol/--mrow. The aspect
     ratio is what fixes the row height, so the whole block scales with the
     screen width instead of being pinned to a magic pixel height. */
  @media (max-width: 639px) {
    .showcase-grid {
      aspect-ratio: 43 / 64;
      grid-template-rows: repeat(15, 1fr);
    }
    .showcase-grid > div {
      grid-column: var(--mcol);
      grid-row: var(--mrow);
    }
  }
</style>
