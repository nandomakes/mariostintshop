---
import { Image } from 'astro:assets';
import { TESTIMONIALS } from '../consts';
import GoogleRatingBadge from './GoogleRatingBadge.astro';

const slides = TESTIMONIALS;

const initials = (name: string) =>
  name
    .split(' ')
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section id="testimonials" class="hex-bg bg-paper">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="flex flex-col items-center text-center">
      <p class="reveal kicker text-accentDk">Testimonials</p>
      <h2 class="reveal headline mt-3 max-w-3xl text-[clamp(1.4rem,2.8vw,2.2rem)] text-ink">
        Real reviews from real people
      </h2>
      <GoogleRatingBadge class="reveal mt-6" />
    </div>

    <div class="relative mt-12">
    <div
      id="testimonial-track"
      class="no-scrollbar flex gap-6 overflow-x-auto scroll-smooth"
      style="overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch; -webkit-tap-highlight-color: transparent;"
      role="region"
      tabindex="0"
      aria-label="Customer reviews carousel"
    >
      {
        slides.map((t) => (
          <figure
            class="flex w-full shrink-0 flex-col bg-mint sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)]"
          >
            {t.photo ? (
              <Image
                src={t.photo.src}
                alt={t.photo.alt}
                widths={[400, 800]}
                sizes="(min-width: 1024px) 384px, (min-width: 640px) 50vw, 100vw"
                loading="lazy"
                draggable={false}
                class="aspect-[8/5] w-full select-none object-cover"
              />
            ) : (
              <div class="flex aspect-[8/5] w-full items-center justify-center bg-accent/10">
                <span class="headline text-4xl tracking-[0.06em] text-accentDk" aria-hidden="true">
                  {initials(t.author)}
                </span>
              </div>
            )}
            <div class="relative flex flex-1 flex-col p-8">
              <div class="flex gap-1 text-accentDk" aria-label="5 out of 5 stars">
                {Array.from({ length: 5 }).map(() => (
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l2.9 6.3 6.9.8-5.1 4.7 1.4 6.8L12 17.2l-6.1 3.4 1.4-6.8L2.2 9.1l6.9-.8L12 2z" />
                  </svg>
                ))}
              </div>
              <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-char">“{t.quote}”</blockquote>
              <hr class="my-5 border-accentDk/15" />
              <figcaption>
                <p class="headline text-base tracking-[0.06em] text-ink">{t.author}</p>
              </figcaption>
              <span class="pointer-events-none absolute bottom-6 right-7 text-accentDk/30" aria-hidden="true">
                <svg width="38" height="38" viewBox="0 0 24 24" fill="currentColor"><path d="M10 7H6a3 3 0 0 0-3 3v4a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-7a4 4 0 0 0-1-2.6L8.6 3 7 4.4 8.4 6A4 4 0 0 1 10 7Zm11 0h-4a3 3 0 0 0-3 3v4a3 3 0 0 0 3 3h2a3 3 0 0 0 3-3v-7a4 4 0 0 0-1-2.6L19.6 3 18 4.4 19.4 6A4 4 0 0 1 21 7Z" /></svg>
              </span>
            </div>
          </figure>
        ))
      }
    </div>

    </div>

    <!-- Scroll progress bar: fills to show position in the review list. -->
    <div class="mx-auto mt-6 h-1 w-full max-w-xs bg-sand" aria-hidden="true">
      <div id="testimonial-progress" class="h-full w-0 bg-accent transition-[width] duration-150"></div>
    </div>

    <!-- Prev/next arrows, centered below the carousel. Mobile relies on
         touch swipe alone — the arrows only appear from sm up. The pause
         control shows at every width, since the autoplay runs at every width. -->
    <div class="mt-5 flex items-center justify-center gap-3">
      <!-- WCAG 2.2.2 (Pause, Stop, Hide): the carousel auto-advances, so it
           needs a control that is reachable by keyboard, not just hover. -->
      <button
        type="button"
        id="testimonial-playpause"
        class="pressable flex h-11 w-11 items-center justify-center bg-ink text-paper shadow-lg transition-colors duration-200 hover:bg-char"
        aria-label="Pause reviews carousel"
      >
        <svg id="testimonial-icon-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5h4v14H7zM13 5h4v14h-4z" /></svg>
        <svg id="testimonial-icon-play" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      </button>
      <button
        type="button"
        data-dir="prev"
        class="testimonial-arrow pressable hidden h-11 w-11 sm:flex items-center justify-center bg-accent text-ink shadow-lg transition-colors duration-200 hover:bg-accentDk disabled:pointer-events-none disabled:opacity-0"
        aria-label="Previous reviews"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg>
      </button>
      <button
        type="button"
        data-dir="next"
        class="testimonial-arrow pressable hidden h-11 w-11 sm:flex items-center justify-center bg-accent text-ink shadow-lg transition-colors duration-200 hover:bg-accentDk disabled:pointer-events-none disabled:opacity-0"
        aria-label="Next reviews"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  // Endless carousel: advances one card every 4s and never reaches an end.
  // Pauses on hover/touch and while the tab is hidden.
  const track = document.getElementById('testimonial-track');
  const progress = document.getElementById('testimonial-progress');
  if (track) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const arrows = Array.from(document.querySelectorAll<HTMLButtonElement>('.testimonial-arrow'));
    const real = track.children.length;

    // Clone the leading cards onto the end so the track can run past the last
    // review into what looks like the first one, then snap back invisibly.
    // The clones are added here rather than in the markup so the page still
    // ships exactly one copy of each review to crawlers.
    const CLONES = Math.min(real, 4);
    for (let i = 0; i < CLONES; i++) {
      const clone = track.children[i].cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      track.appendChild(clone);
    }
    const slides = Array.from(track.children) as HTMLElement[];

    let idx = 0;
    let paused = false;

    const syncProgress = () => {
      if (progress) progress.style.width = `${(((idx % real) + 1) / real) * 100}%`;
    };
    const go = (i: number, smooth: boolean) => {
      idx = Math.max(0, Math.min(i, slides.length - 1));
      track.scrollTo({
        left: slides[idx].offsetLeft - slides[0].offsetLeft,
        behavior: smooth && !reduce ? 'smooth' : 'auto',
      });
      syncProgress();
    };

    // Once parked on a clone, the scroll position is rewound by one full set.
    // It looks identical either side of the rewind, so nothing is visible.
    let wrapTimer = 0;
    const rewind = () => {
      if (!wrapTimer) return;
      clearTimeout(wrapTimer);
      wrapTimer = 0;
      go(idx - real, false);
    };

    const next = () => {
      rewind(); // settle any pending rewind before stepping on
      go(idx + 1, true);
      // Let the animation land first, otherwise the rewind cuts it short.
      if (idx >= real) wrapTimer = window.setTimeout(rewind, 700);
    };
    const prev = () => {
      rewind();
      if (idx <= 0) {
        // Jump forward to the matching clone first; it looks the same, so
        // easing back from there reads as a normal backwards step.
        go(idx + real, false);
      }
      const target = idx - 1;
      requestAnimationFrame(() => go(target, true));
    };

    syncProgress();

    track.addEventListener('mouseenter', () => (paused = true));
    track.addEventListener('mouseleave', () => (paused = false));
    track.addEventListener('touchstart', () => (paused = true), { passive: true });
    track.addEventListener('touchend', () => setTimeout(() => (paused = false), 4000), { passive: true });

    // There is no start or end any more, so the arrows are never disabled.
    arrows.forEach((btn) => {
      btn.disabled = false;
      btn.addEventListener('pointerdown', (e) => e.preventDefault());
      btn.addEventListener('click', () => {
        if (btn.dataset.dir === 'next') next();
        else prev();
      });
    });

    // Explicit user pause, kept separate from the transient hover/touch pause
    // so hovering can't silently resume a carousel the user chose to stop.
    let stopped = reduce;
    const playPause = document.getElementById('testimonial-playpause');
    const iconPause = document.getElementById('testimonial-icon-pause');
    const iconPlay = document.getElementById('testimonial-icon-play');

    const renderPlayState = () => {
      if (!playPause) return;
      playPause.setAttribute(
        'aria-label',
        stopped ? 'Play reviews carousel' : 'Pause reviews carousel'
      );
      iconPause?.classList.toggle('hidden', stopped);
      iconPlay?.classList.toggle('hidden', !stopped);
    };

    if (playPause) {
      // With reduced motion the carousel never auto-advances, so the control
      // would be a lie — hide it rather than offer a no-op.
      if (reduce) playPause.classList.add('hidden');
      renderPlayState();
      playPause.addEventListener('click', () => {
        stopped = !stopped;
        renderPlayState();
      });
    }

    if (!reduce) {
      setInterval(() => {
        if (stopped || paused || document.hidden) return;
        next();
      }, 4000);
    }
  }
</script>
