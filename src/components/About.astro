---
import { Image } from 'astro:assets';
import { ABOUT, IMAGES } from '../consts';

// Words for the diagonal band running behind the Lamborghini artwork.
const bandItems = ['Window Tint', 'PPF', 'Ceramic Coating', 'Tesla', 'Commercial Film'];
const bandSeq = [...bandItems, ...bandItems, ...bandItems, ...bandItems];
---

<section id="about" class="hex-bg relative overflow-hidden bg-paper">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-28">
    <!-- Two-column intro: title + CTA left, copy right -->
    <div class="grid gap-10 md:grid-cols-2 md:items-start">
      <div class="reveal">
        <p class="kicker text-accentDk">About us</p>
        <h2 class="headline mt-3 text-[clamp(1.4rem,2.8vw,2.2rem)] text-ink">
          Crafting excellence in surface protection & style
        </h2>
        <a
          href="/visualizer"
          class="pressable sticker mt-8 inline-block bg-accent px-8 py-3.5 text-xs font-bold uppercase tracking-[0.12em] text-ink transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-accentDk"
        >
          Try the Film Visualizer <span class="ml-0.5 font-black" aria-hidden="true">&gt;</span>
        </a>
      </div>
      <div class="reveal space-y-4 text-[15px] leading-relaxed text-char md:pt-8">
        <p>{ABOUT.lead}</p>
        <p>{ABOUT.body1}</p>
        <p>{ABOUT.body2}</p>
      </div>
    </div>

    <!-- Centered artwork: a blurred copy of the same photo sits behind
         everything as an atmospheric glow, then the semi-transparent diagonal
         band, then the sharp Lamborghini on top. -->
    <div class="reveal relative mx-auto mt-12 max-w-5xl">
      <Image
        src={IMAGES.install.src}
        alt=""
        aria-hidden="true"
        widths={[800]}
        loading="lazy"
        class="pointer-events-none absolute left-1/2 top-1/2 h-[140%] w-[140%] -translate-x-1/2 -translate-y-1/2 scale-110 object-contain opacity-40 blur-2xl"
      />

      <!-- Hex fade-out: a white gradient rotated to match the band's angle,
           so the hex pattern dissolves gently just above the band and is
           fully gone from the band downward (no hard cut, no leftover trace). -->
      <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-screen w-[200vw] -translate-x-1/2 -translate-y-1/2 -rotate-2"
        style="background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,0) 33%, #ffffff 49%, #ffffff 100%);"
        aria-hidden="true"
      ></div>

      <!-- Semi-transparent accent band, vertically centered behind the image -->
      <div
        class="marquee absolute left-1/2 top-1/2 w-screen -translate-x-1/2 -translate-y-1/2 -rotate-2 bg-accent/80 py-1.5 sm:py-2 md:py-3"
        aria-hidden="true"
      >
        <div class="marquee-track">
          {
            bandSeq.map((label, i) => (
              <span class="mx-3 flex items-center gap-6 whitespace-nowrap sm:mx-4 sm:gap-8 md:mx-5 md:gap-10">
                <span
                  class:list={[
                    'headline text-sm tracking-[0.06em] sm:text-base sm:tracking-[0.08em] md:text-xl',
                    i % 2 === 0 ? 'text-paper' : 'text-ink/70',
                  ]}
                >
                  {label}
                </span>
                <span class="text-paper">✦</span>
              </span>
            ))
          }
        </div>
      </div>

      <Image
        src={IMAGES.install.src}
        alt={IMAGES.install.alt}
        widths={[400, 800]}
        sizes="55vw"
        loading="lazy"
        class="relative mx-auto w-[55%] object-contain"
      />
    </div>
  </div>
</section>
