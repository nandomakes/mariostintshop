---
import { ABOUT } from '../consts';

const VIDEO = { id: 'ElI529-OuGs', title: "Meet Mario Rodriguez — Mario's Tint Shop" };

// Words for the band that runs behind the row.
const bandItems = ['Window Tint', 'PPF', 'Ceramic Coating', 'Tesla', 'Commercial Film'];
const bandSeq = [...bandItems, ...bandItems, ...bandItems, ...bandItems];
---

<section id="about" class="hex-bg relative overflow-hidden bg-paper">
  <div class="mx-auto max-w-6xl px-5 pt-20 md:pt-24">
    <!-- Copy and video sit side by side so the section stays compact —
         stacking them left a tall column of mostly empty space. -->
    <div class="grid gap-10 md:grid-cols-2 md:items-center md:gap-12">
      <div class="reveal">
        <p class="kicker text-accentDk">About us</p>
        <h2 class="headline mt-3 text-[clamp(1.4rem,2.8vw,2.2rem)] text-ink">
          Crafting excellence in surface protection & style
        </h2>
        <div class="mt-5 space-y-4 text-[15px] leading-relaxed text-char">
          <p>{ABOUT.lead}</p>
          <p>{ABOUT.body1}</p>
        </div>
        <a
          href="/visualizer"
          class="pressable sticker mt-7 inline-block bg-accent px-8 py-3.5 text-xs font-bold uppercase tracking-[0.12em] text-ink transition-[background-color,transform] duration-200 hover:-translate-y-0.5 hover:bg-accentDk"
        >
          Try the Film Visualizer <span class="ml-0.5 font-black">&gt;</span>
        </a>
      </div>

      <div class="reveal">
        <!-- Shop intro video. Only the poster loads up front; the YouTube
             player is injected on click so the page isn't paying for its
             ~1MB of script on every visit. The frame is dark so the player's
             own letterboxing reads as part of it rather than a stray edge. -->
        <div class="border border-ink/10 bg-ink p-1.5 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.45)]">
          <div id="about-video" class="relative aspect-video w-full overflow-hidden">
            <button
              type="button"
              class="group absolute inset-0 h-full w-full"
              aria-label={`Play video: ${VIDEO.title}`}
            >
              <img
                src="/images/about-video-poster.webp"
                alt="Mario Rodriguez at Mario's Tint Shop"
                width="1280"
                height="720"
                loading="lazy"
                class="absolute inset-0 h-full w-full scale-[1.02] object-cover"
              />
              <span
                class="absolute inset-0 grid place-items-center bg-ink/20 transition-colors duration-300 group-hover:bg-ink/5"
                aria-hidden="true"
              >
                <span class="flex h-16 w-16 items-center justify-center rounded-full bg-accent text-ink shadow-xl transition-transform duration-300 ease-out group-hover:scale-110">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="ml-1">
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
              </span>
            </button>
          </div>
        </div>
        <p class="mt-4 text-sm italic leading-relaxed text-ash">{ABOUT.body2}</p>
      </div>
    </div>
  </div>

  <!-- The services marquee runs full-bleed under the row as a straight
       section divider, doubling as the hand-off into the Services section.
       Sized to match the hero's Ticker band so the two read as one system. -->
  <div class="marquee mt-20 bg-[#5FC2FF] py-3.5 [mask-image:none] md:mt-24 [-webkit-mask-image:none]" aria-hidden="true">
    <div class="marquee-track">
      {
        bandSeq.map((label, i) => (
          <span class="mx-5 flex items-center gap-10 whitespace-nowrap">
            <span
              class:list={[
                'headline text-xl tracking-[0.08em]',
                i % 2 === 0 ? 'text-paper' : 'text-ink/70',
              ]}
            >
              {label}
            </span>
            <span class="text-paper">✦</span>
          </span>
        ))
      }
    </div>
  </div>
</section>

<script is:inline define:vars={{ VIDEO }}>
  (() => {
    const box = document.getElementById('about-video');
    const btn = box?.querySelector('button');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      // enablejsapi lets us pause it over postMessage when it scrolls away.
      frame.src = `https://www.youtube-nocookie.com/embed/${VIDEO.id}?autoplay=1&rel=0&enablejsapi=1`;
      frame.title = VIDEO.title;
      frame.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      frame.allowFullscreen = true;
      // Slightly oversized and clipped, so the player's own letterbox edge
      // doesn't show as a black line down the side.
      frame.className = 'absolute left-1/2 top-1/2 h-[calc(100%+4px)] w-[calc(100%+4px)] -translate-x-1/2 -translate-y-1/2 border-0';
      box.replaceChildren(frame);

      // Stop playback once it leaves the viewport — nobody wants audio
      // following them down the page.
      const io = new IntersectionObserver(
        ([e]) => {
          if (e.isIntersecting) return;
          frame.contentWindow?.postMessage(
            JSON.stringify({ event: 'command', func: 'pauseVideo', args: '' }),
            '*'
          );
        },
        { threshold: 0 }
      );
      io.observe(box);
    });
  })();
</script>
