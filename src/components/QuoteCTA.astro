---
import { CONTACT, WHY_US, TINTWIZ_FORM_URL } from '../consts';

interface Props {
  defaultService?: string; // named in the copy on per-service pages
}
const { defaultService } = Astro.props;
---

<section id="contact" class="bg-ink">
  <div class="mx-auto max-w-6xl px-5 py-20 md:py-24">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-16">
      <!-- Left: text content -->
      <div class="reveal lg:self-start lg:sticky lg:top-28">
        <p class="kicker text-accent">Protect. Enhance. Transform.</p>
        <h2 class="headline mt-3 text-[clamp(1.4rem,2.8vw,2.2rem)] text-paper">
          Get a quote today!
        </h2>
        <p class="mt-5 max-w-[54ch] text-[15px] leading-relaxed text-smoke">
          Tell us about your vehicle{
            defaultService ? ` and your ${defaultService.toLowerCase()} job` : ' and what you want to protect'
          } in the form. It goes straight to our shop
          and we reply the same business day with an honest recommendation and a
          clear price — no obligation.
        </p>
        <ul class="mt-8 space-y-4">
          {
            WHY_US.bullets.slice(0, 4).map((b) => (
              <li class="flex items-start gap-3.5 text-[15px] leading-relaxed text-paper">
                <span
                  class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center bg-accent text-ink"
                  aria-hidden="true"
                >
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12.5l5.5 5.5L20 6.5" /></svg>
                </span>
                {b}
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-sm text-smoke">
          Prefer to talk? Call us at
          <a
            href={`tel:${CONTACT.phoneTel}`}
            class="font-bold text-accent underline underline-offset-4 hover:text-accentDk"
          >
            {CONTACT.phoneDisplay}
          </a>
          · {CONTACT.scheduleShort}
        </p>
      </div>

      <!-- Right: Tintwiz quote form, embedded. We don't control the form's
           own CSS (cross-origin), so instead of letting it run long and
           scroll internally, we scale the whole iframe down and compensate
           its width/height so it still fills the card — same fields, more
           compact. The iframe owns its own validation and submission;
           nothing posts from this site. -->
      <div class="reveal overflow-hidden bg-paper p-2 shadow-[0_30px_60px_-30px_rgba(0,0,0,0.6)] sm:p-4">
        <h3 class="sr-only">Request a Quote</h3>
        <div class="quotewrap w-full overflow-hidden">
          <iframe
            src={TINTWIZ_FORM_URL}
            title="Request a quote from Mario's Tint Shop"
            loading="lazy"
            scrolling="no"
            class="quoteiframe border-0"
            referrerpolicy="strict-origin-when-cross-origin"
          ></iframe>
        </div>
        <noscript>
          <p class="p-4 text-sm text-char">
            Our quote form needs JavaScript. Call us at {CONTACT.phoneDisplay} and
            we'll take your details over the phone.
          </p>
        </noscript>
      </div>
    </div>
  </div>
</section>

<style>
  /* The form's own CSS is cross-origin, so we scale the whole iframe and
     compensate its width/height to fill the card. The scale factor has to
     differ per breakpoint because it's tuned against the card's width. */
  .quotewrap {
    height: 540px;
  }
  .quoteiframe {
    width: 160%;
    height: 864px;
    transform: scale(0.625);
    transform-origin: top left;
  }
  @media (min-width: 640px) {
    .quotewrap {
      height: 548px;
    }
    .quoteiframe {
      width: 138.9%;
      height: 761px;
      transform: scale(0.72);
    }
  }
</style>
