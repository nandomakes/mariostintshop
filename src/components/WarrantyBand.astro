---
// Warranty + turnaround reassurance band.
//
// WARRANTY has been written in consts.ts since launch but was never rendered
// anywhere. "How long will you have my car" and "what if it fails" are two of
// the biggest pre-purchase objections, and competitors win on exactly this.
import { WARRANTY, CONTACT } from '../consts';

interface Props {
  /** Real shop turnaround, e.g. "Most tint installs: 2–3 hours". Omitted
   *  until the shop supplies real figures — the line simply doesn't render. */
  turnaround?: string;
  /** Per-service H2. The default talks about window films, which is wrong on
   *  the ceramic-coating and PPF pages — those pass their own. */
  headline?: string;
  body?: string;
}
const { turnaround, headline = WARRANTY.headline, body = WARRANTY.body } = Astro.props;
---

<section class="border-y border-sand bg-whisper">
  <div class="mx-auto max-w-6xl px-5 py-16 md:py-20">
    <div class="grid gap-10 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-14">
      <div class="reveal">
        <p class="kicker text-accentDk">Backed in writing</p>
        <h2 class="headline mt-3 text-[clamp(1.5rem,3vw,2.25rem)] text-ink">
          {headline}
        </h2>
        <p class="mt-5 max-w-[58ch] text-[15px] leading-relaxed text-char">
          {body}
        </p>
      </div>

      <ul class="reveal grid gap-4">
        <li class="flex items-start gap-4 border border-sand bg-paper p-5 shadow-[0_2px_10px_rgba(0,0,0,0.05)]">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center bg-accent text-ink"
            aria-hidden="true"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 3v5c0 4.6-3 7.7-7 9-4-1.3-7-4.4-7-9V6z" /><path d="M9.2 12l2 2 3.6-3.7" />
            </svg>
          </span>
          <span>
            <span class="headline block text-sm tracking-[0.06em] text-ink">
              Manufacturer-backed
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-char">
              Authorized 3M Platinum Dealer — every film and coating carries its 3M warranty.
            </span>
          </span>
        </li>

        {
          turnaround && (
            <li class="flex items-start gap-4 border border-sand bg-paper p-5 shadow-[0_2px_10px_rgba(0,0,0,0.05)]">
              <span
                class="flex h-11 w-11 shrink-0 items-center justify-center bg-accent text-ink"
                aria-hidden="true"
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
                </svg>
              </span>
              <span>
                <span class="headline block text-sm tracking-[0.06em] text-ink">Turnaround</span>
                <span class="mt-1 block text-sm leading-relaxed text-char">{turnaround}</span>
              </span>
            </li>
          )
        }

        <li class="flex items-start gap-4 border border-sand bg-paper p-5 shadow-[0_2px_10px_rgba(0,0,0,0.05)]">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center bg-accent text-ink"
            aria-hidden="true"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6.6 10.8c1.4 2.7 3.6 4.9 6.3 6.3l2.1-2.1c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.5.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.5.1.4 0 .8-.2 1.1L6.6 10.8Z" />
            </svg>
          </span>
          <span>
            <span class="headline block text-sm tracking-[0.06em] text-ink">
              Questions first, quote second
            </span>
            <span class="mt-1 block text-sm leading-relaxed text-char">
              Call
              <a
                href={`tel:${CONTACT.phoneTel}`}
                class="font-bold text-accentDk underline underline-offset-4 hover:text-accent"
              >
                {CONTACT.phoneDisplay}
              </a>
              — {CONTACT.scheduleShort}.
            </span>
          </span>
        </li>
      </ul>
    </div>
  </div>
</section>
