# Instagram feed (optional) — powers the "Our Instagram" gallery.
#
# Without these, the gallery falls back to the curated images in consts.ts.
# With a token, the build pulls the latest posts from @mariostintshop via the
# Instagram Graph API (refreshes on each deploy — rebuild to fetch new posts).
#
# How to get a long-lived token:
#   1. Convert @mariostintshop to a Professional (Business/Creator) account.
#   2. Create a Meta app → add "Instagram" → Instagram API with Instagram Login.
#   3. Generate a User access token, then exchange it for a long-lived token
#      (~60 days, refreshable) with the ig_user_media scope.
# Paste the long-lived token below (copy this file to `.env`).

INSTAGRAM_TOKEN=
# Optional; defaults to "me" (the token's own account).
INSTAGRAM_USER_ID=

# Careers form (api/apply.js) — emails each job application, resume attached.
# Set these in Vercel → Project → Settings → Environment Variables (Production
# AND Preview). They're read at request time, not build time.
#   1. Create a free account at resend.com → API Keys → create a "Sending" key.
#   2. Until mariostintshop.com is verified in Resend (Domains → add DNS records),
#      the default sender onboarding@resend.dev can ONLY email the address that
#      owns the Resend account. Verify the domain, then set CAREERS_FROM_EMAIL.
RESEND_API_KEY=
# Who gets notified. Comma-separate for several recipients.
CAREERS_NOTIFY_EMAIL=
# Optional, e.g. "Mario's Tint Shop Careers <careers@mariostintshop.com>"
CAREERS_FROM_EMAIL=
